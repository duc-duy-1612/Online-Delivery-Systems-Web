@{
    ViewBag.Title = "Lỗi";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h1 class="display-1 text-danger">⚠️</h1>
                        <h2 class="card-title">Đã xảy ra lỗi</h2>
                    </div>
                    
                    <div class="alert alert-danger" role="alert">
                        <strong>@(ViewBag.ErrorMessage ?? "Đã xảy ra lỗi. Vui lòng thử lại sau.")</strong>
                    </div>

                    <p class="text-muted text-center">
                        Nếu lỗi vẫn tiếp tục xảy ra, vui lòng liên hệ bộ phận hỗ trợ.
                    </p>

                    <div class="text-center mt-4">
                        <a href="@Url.Action("TrangChu", "Home")" class="btn btn-primary">
                            <i class="bi bi-house"></i> Về trang chủ
                        </a>
                        <button onclick="window.history.back();" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Quay lại
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

