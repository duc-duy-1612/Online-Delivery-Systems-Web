<style>
    body { background: #f8f9fa; font-family: 'Inter', sans-serif; }
    .card { border: 1px solid rgba(0,0,0,0.07) !important; border-radius: 1rem !important; box-shadow: 0 4px 16px rgba(0,0,0,0.06) !important; }
    .card-header { border-bottom: 1px solid rgba(0,0,0,0.06) !important; background: #fff !important; }
    h4.fw-bold, h5.fw-bold, h3.fw-bold { color: #1a202c !important; }
    .text-muted { color: #718096 !important; }
    .btn-primary { background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; color: #fff !important; }
    .btn-primary:hover { box-shadow: 0 6px 18px rgba(255,90,43,0.35) !important; }
    .btn-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-secondary { border-radius: 0.75rem !important; font-weight: 600 !important; }
    .form-control, .form-select { border-radius: 0.75rem !important; border: 1.5px solid #e2e8f0 !important; background: #f7fafc !important; color: #2d3748 !important; transition: all 0.2s; }
    .form-control:focus, .form-select:focus { background: #fff !important; border-color: #ff5a2b !important; box-shadow: 0 0 0 3px rgba(255,90,43,0.12) !important; }
    .table thead th { background: #f8fafc !important; color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #e2e8f0 !important; }
    .table tbody tr:hover { background: #fffaf8 !important; }
    .table td { border-color: #f0f2f5 !important; vertical-align: middle; }
    .badge.bg-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; color: #fff !important; }
    .badge.bg-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; }
    .badge.bg-warning { background: linear-gradient(135deg, #f59e0b, #d97706) !important; color: #fff !important; }
    .badge.bg-info    { background: linear-gradient(135deg, #3b82f6, #2563eb) !important; color: #fff !important; }
    .alert { border-radius: 0.85rem !important; }
    .alert-success { background: #d1fae5 !important; color: #065f46 !important; border: 1px solid #a7f3d0 !important; }
    .alert-danger  { background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fecaca !important; }
    .alert-info    { background: #dbeafe !important; color: #1e40af !important; border: 1px solid #93c5fd !important; }
    .alert-warning { background: #fef3c7 !important; color: #92400e !important; border: 1px solid #fde68a !important; }
    label { color: #4a5568 !important; font-weight: 600; }
</style>
@model List<ĐACN.LoaiMonAn>

@{
    ViewBag.Title = "Quản Lý Danh Mục Món Ăn";
    ViewBag.Active = "DanhMuc";
    Layout = "~/Views/Shared/_LayoutNhaHang.cshtml";


    if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
}

<div class="row">
</div>

---

<div class="row">
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="bi bi-plus-circle-fill"></i> Thêm Danh Mục Mới</h5>
            </div>
            <div class="card-body">

                <form id="categoryForm" action="@Url.Action("ThemDanhMuc", "NhaHang")" method="post" enctype="multipart/form-data">


                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label for="MaLoai" class="form-label">Mã Danh Mục:</label>

                        <input type="text" class="form-control" id="MaLoai" name="MaLoai" list="loaiMonAnList" required maxlength="20">
                    </div>


                    <datalist id="loaiMonAnList">
                        @if (ViewBag.AllLoaiMonAn != null)
                        {

                            foreach (ĐACN.LoaiMonAn loai in ViewBag.AllLoaiMonAn)
                            {
                                <option value="@loai.MaLoai">@loai.TenLoai</option>
                            }
                        }
                    </datalist>

                    <div class="mb-3">
                        <label for="TenLoai" class="form-label">Tên Danh Mục:</label>

                        <input type="text" class="form-control" id="TenLoai" name="TenLoai" required maxlength="100">
                    </div>

                    <div class="mb-3">
                        <label for="HinhAnh" class="form-label">Ảnh Đại Diện (Icon):</label>

                        <input type="file" class="form-control" id="HinhAnh" name="HinhAnh" accept="image/*">
                    </div>

                    <button type="submit" class="btn btn-success w-100"><i class="bi bi-floppy"></i> Lưu Danh Mục</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-header bg-white">
                <h5 class="mb-0">Danh Sách Các Loại Món Ăn</h5>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;" class="ps-4">Ảnh</th>
                                <th>Mã Loại</th>
                                <th>Tên Loại</th>
                                <th class="text-center pe-4" style="width: 200px;">Hành Động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="ps-4">
                                            @{
                                                var finalImg = item.HinhAnh;
                                                if (string.IsNullOrEmpty(finalImg))
                                                {
                                                    string maLoaiLower = item.MaLoai?.ToLower().Trim() ?? "";
                                                    var imageMap = new Dictionary<string, string> {
                                                        { "anvat", "an_vat.png" }, { "an_vat", "an_vat.png" }, { "bun", "bun.png" },
                                                        { "chay", "chay.png" }, { "com", "com.png" }, { "haisan", "haisan.png" },
                                                        { "hai_san", "haisan.png" }, { "lau", "lau.png" }, { "mi", "mi.png" },
                                                        { "pho", "pho.png" }, { "pizza", "pizza.png" }, { "steak", "steak.png" },
                                                        { "sushi", "sushi.png" }, { "trasua", "trasua.png" }, { "tra_sua", "trasua.png" }
                                                    };
                                                    if (imageMap.ContainsKey(maLoaiLower)) { finalImg = imageMap[maLoaiLower]; }
                                                    else { finalImg = "com.png"; }
                                                }
                                                else if (!finalImg.Contains("."))
                                                {
                                                    finalImg += ".png";
                                                }
                                            }
                                            <img src="@Url.Content("~/images/danhmuc/" + finalImg)" alt="@item.TenLoai" class="rounded-circle shadow-sm" style="width: 45px; height: 45px; object-fit: cover;" onerror="this.onerror=null; this.src='@Url.Content("~/images/danhmuc/com.png")';" />
                                        </td>
                                        <td class="text-muted fw-bold">@item.MaLoai</td>
                                        <td class="fw-bold text-dark">@item.TenLoai</td>
                                        <td class="text-center pe-4">

                                            <button type="button" class="btn btn-sm btn-outline-primary btn-action me-2" onclick="editCategory('@item.MaLoai', '@item.TenLoai')">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </button>

                                            <a href="javascript:void(0);" class="btn btn-sm btn-outline-danger btn-action" onclick="confirmDeleteCat('@item.MaLoai', '@item.TenLoai')">
                                                <i class="bi bi-trash"></i> Xóa
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-3">Chưa có danh mục nào được thêm.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function editCategory(maLoai, tenLoai) {

            document.querySelector('#categoryForm .card-header h5').innerHTML = '<i class="bi bi-pencil-square"></i> Chỉnh Sửa Danh Mục: ' + maLoai;


            document.getElementById('categoryForm').action = '@Url.Action("SuaDanhMuc", "NhaHang")';


            document.getElementById('MaLoai').value = maLoai;
            document.getElementById('TenLoai').value = tenLoai;


            document.getElementById('MaLoai').readOnly = true;


            document.getElementById('HinhAnh').style.display = 'none';
            document.querySelector('label[for="HinhAnh"]').textContent = 'Ảnh Đại Diện (Chỉ thay đổi nếu cần):';



            document.querySelector('#categoryForm button[type="submit"]').innerHTML = '<i class="bi bi-arrow-clockwise"></i> Cập Nhật';


            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function confirmDeleteCat(maLoai, tenLoai) {
            Swal.fire({
                title: 'Xác nhận xóa',
                text: 'Bạn có chắc chắn muốn xóa danh mục ' + tenLoai + ' không?',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Có, xóa!',
                cancelButtonText: 'Không'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("XoaDanhMuc", "NhaHang")?id=' + maLoai;
                }
            });
        }
    </script>
}
