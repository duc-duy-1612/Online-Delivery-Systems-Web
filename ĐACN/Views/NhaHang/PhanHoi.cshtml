<style>
    body { background: #f8f9fa; font-family: 'Inter', sans-serif; }
    .card { border: 1px solid rgba(0,0,0,0.07) !important; border-radius: 1rem !important; box-shadow: 0 4px 16px rgba(0,0,0,0.06) !important; }
    .card-header { border-bottom: 1px solid rgba(0,0,0,0.06) !important; background: #fff !important; }
    h4.fw-bold, h5.fw-bold, h3.fw-bold { color: #1a202c !important; }
    .text-muted { color: #718096 !important; }
    .btn-primary { background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; color: #fff !important; }
    .btn-primary:hover { box-shadow: 0 6px 18px rgba(255,90,43,0.35) !important; }
    .btn-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-secondary { border-radius: 0.75rem !important; font-weight: 600 !important; }
    .form-control, .form-select { border-radius: 0.75rem !important; border: 1.5px solid #e2e8f0 !important; background: #f7fafc !important; color: #2d3748 !important; transition: all 0.2s; }
    .form-control:focus, .form-select:focus { background: #fff !important; border-color: #ff5a2b !important; box-shadow: 0 0 0 3px rgba(255,90,43,0.12) !important; }
    .table thead th { background: #f8fafc !important; color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #e2e8f0 !important; }
    .table tbody tr:hover { background: #fffaf8 !important; }
    .table td { border-color: #f0f2f5 !important; vertical-align: middle; }
    .badge.bg-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; color: #fff !important; }
    .badge.bg-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; }
    .badge.bg-warning { background: linear-gradient(135deg, #f59e0b, #d97706) !important; color: #fff !important; }
    .badge.bg-info    { background: linear-gradient(135deg, #3b82f6, #2563eb) !important; color: #fff !important; }
    .alert { border-radius: 0.85rem !important; }
    .alert-success { background: #d1fae5 !important; color: #065f46 !important; border: 1px solid #a7f3d0 !important; }
    .alert-danger  { background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fecaca !important; }
    .alert-info    { background: #dbeafe !important; color: #1e40af !important; border: 1px solid #93c5fd !important; }
    .alert-warning { background: #fef3c7 !important; color: #92400e !important; border: 1px solid #fde68a !important; }
    label { color: #4a5568 !important; font-weight: 600; }
</style>
@model IEnumerable<ĐACN.Models.DanhGiaNhaHangDisplayViewModel>
    @{
    ViewBag.Title = "Phản hồi khách hàng";
    Layout = "~/Views/Shared/_LayoutNhaHang.cshtml";
    ViewBag.Active = "PhanHoi";

    var soLuongDanhGia = ViewBag.SoLuongDanhGia ?? 0;
    var diemTrungBinh = ViewBag.DiemTrungBinh ?? 0.0;
    }

    <div class="container-fluid">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">💬 Phản hồi khách hàng</h4>
            </div>
            <div class="card-body">
                @if (TempData["Message"] != null)
                {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @TempData["Message"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
                }

                <!-- Thống kê tổng quan -->
                <div class="row mb-4">
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="text-muted mb-1">Điểm đánh giá trung bình</h5>
                                <h2 class="text-primary mb-0">@diemTrungBinh.ToString("N1")</h2>
                                <div class="d-flex justify-content-center gap-1 mt-2" style="font-size: 1.2rem;">
                                    @{
                                    int soSaoLamTron = (int)Math.Round(diemTrungBinh);
                                    }
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                    if (i <= soSaoLamTron)
                                    {
                                    <span style="color: #ffc107;">⭐</span>
                                    }
                                    else
                                    {
                                    <span style="color: #ddd; opacity: 0.3;">⭐</span>
                                    }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card bg-light">
                            <div class="card-body text-center">
                                <h5 class="text-muted mb-1">Tổng số đánh giá</h5>
                                <h2 class="text-primary mb-0">@soLuongDanhGia</h2>
                                <small class="text-muted">lượt đánh giá</small>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                @if (Model == null || !Model.Any())
                {
                <div class="text-center py-5">
                    <div style="font-size: 4rem; opacity: 0.3;">💬</div>
                    <h5 class="text-muted mt-3">Chưa có phản hồi nào từ khách hàng</h5>
                    <p class="text-muted">Khách hàng sẽ để lại phản hồi sau khi trải nghiệm dịch vụ của bạn.</p>
                </div>
                }
                else
                {
                <div class="list-group">
                    @foreach (var dg in Model)
                    {
                    <div class="list-group-item">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="mb-1 fw-bold">
                                    @dg.TenKhachHang
                                    @if (!string.IsNullOrEmpty(dg.MaDon) && dg.MaDon.StartsWith("RATE_"))
                                    {
                                    <span class="badge bg-info text-dark ms-2">Đánh giá tự do</span>
                                    }
                                    else if (!string.IsNullOrEmpty(dg.MaDon))
                                    {
                                    <span class="badge bg-secondary ms-2">Đơn: @dg.MaDon</span>
                                    }
                                </h6>
                                <small class="text-muted">
                                    @if (dg.ThoiGianDanhGia.HasValue)
                                    {
                                    @dg.ThoiGianDanhGia.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                </small>
                            </div>
                            <div class="d-flex align-items-center gap-1" style="font-size: 1.1rem;">
                                @if (dg.Diem.HasValue)
                                {
                                for (int i = 1; i <= 5; i++)
                                {
                                if (i <= dg.Diem.Value)
                                {
                                <span style="color: #ffc107;">⭐</span>
                                }
                                else
                                {
                                <span style="color: #ddd; opacity: 0.3;">⭐</span>
                                }
                                }
                                <span class="ms-2 fw-bold text-primary">@dg.Diem.Value/5</span>
                                }
                                else
                                {
                                <span class="text-muted">Chưa có điểm</span>
                                }
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(dg.NhanXet))
                        {
                        <p class="mb-0 mt-2 text-secondary">@dg.NhanXet</p>
                        }
                        else
                        {
                        <p class="mb-0 mt-2 text-muted fst-italic">Khách hàng không để lại bình luận</p>
                        }
                    </div>
                    }
                </div>
                }
            </div>
        </div>
    </div>

