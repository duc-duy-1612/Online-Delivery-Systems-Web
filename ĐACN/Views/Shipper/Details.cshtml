@model ĐACN.Models.DonHangDetailsViewModel
@using System.Linq

@{
    ViewBag.Title = "Shipper - Chi tiết đơn hàng";
    Layout = "~/Views/Shared/_LayoutShipper.cshtml";
}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
                <div>
                    <span class="text-uppercase text-muted fw-bold" style="letter-spacing: 1px; font-size: 0.85rem;">CHI TIẾT ĐƠN HÀNG</span>
                    <h2 class="mb-0 fw-bold mt-1">@(Model != null ? "#" + Model.MaDon : "")</h2>
                </div>
                <a href="@Url.Action("Index", "Shipper")" class="btn btn-outline-dark" style="border-radius: 50px; padding: 8px 24px;">Quay lại</a>
            </div>

            @if (Model == null)
            {
                <div class="alert alert-danger" style="border-radius: 12px;">Không tìm thấy đơn hàng.</div>
            }
            else
            {
                <div class="card shadow-sm mb-4" style="border-radius: 16px; border: none;">
                    <div class="card-body p-4 p-md-5">
                        
                        <div class="row mb-5">
                            <div class="col-md-6 mb-4 mb-md-0">
                                <div class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">TRẠNG THÁI</div>
                                <span class="badge bg-dark fw-normal px-3 py-2" style="font-size: 0.9rem; border-radius: 50px;">@Model.TrangThai</span>
                            </div>
                            <div class="col-md-6 text-md-end">
                                <div class="text-uppercase text-muted fw-bold mb-1" style="font-size: 0.75rem; letter-spacing: 1px;">THỜI GIAN ĐẶT</div>
                                <div class="fw-bold text-dark fs-5">@(Model.ThoiGianDat?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</div>
                            </div>
                        </div>

                        <div class="row mb-5">
                            <div class="col-md-6 border-end">
                                <div class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">THÔNG TIN NHÀ HÀNG</div>
                                @if (Model.NhaHang != null)
                                {
                                    <h5 class="fw-bold mb-1">@Model.NhaHang.TenNH</h5>
                                    <p class="text-muted mb-1" style="font-size: 0.95rem;">@Model.NhaHang.DiaChi</p>
                                    if (!string.IsNullOrEmpty(Model.NhaHang.SDT))
                                    {
                                        <a href="tel:@Model.NhaHang.SDT" class="text-dark fw-bold text-decoration-none">@Model.NhaHang.SDT</a>
                                    }
                                }
                            </div>
                            <div class="col-md-6 ps-md-4 mt-4 mt-md-0">
                                <div class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">THÔNG TIN GIAO HÀNG</div>
                                @if (Model.KhachHang != null)
                                {
                                    <h5 class="fw-bold mb-1">@Model.KhachHang.TenKH</h5>
                                    <p class="text-muted mb-1" style="font-size: 0.95rem;">@Model.KhachHang.DiaChi</p>
                                    if (!string.IsNullOrEmpty(Model.KhachHang.SDT))
                                    {
                                        <a href="tel:@Model.KhachHang.SDT" class="text-dark fw-bold text-decoration-none">@Model.KhachHang.SDT</a>
                                    }
                                }
                            </div>
                        </div>

                        <!-- BẢN ĐỒ GIAO HÀNG -->
                        @if (Model.NhaHang != null && Model.KhachHang != null && !string.IsNullOrEmpty(Model.MaShipper))
                        {
                            <div class="mb-5">
                                <div class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">BẢN ĐỒ ĐỊNH VỊ GIAO HÀNG</div>
                                <div id="map" style="width: 100%; height: 350px; border-radius: 12px; background: #f3f4f6; box-shadow: inset 0 2px 4px rgba(0,0,0,0.06); position: relative; z-index: 1;"></div>
                            </div>
                        }

                        <div class="text-uppercase text-muted fw-bold mb-3" style="font-size: 0.75rem; letter-spacing: 1px;">CHI TIẾT MÓN ĂN</div>
                        
                        @if (Model.ChiTietMonAn != null && Model.ChiTietMonAn.Any())
                        {
                            <div class="table-responsive mb-4">
                                <table class="table align-middle border-bottom">
                                    <thead>
                                        <tr class="text-muted" style="font-size: 0.85rem;">
                                            <th class="ps-0 border-top-0 border-bottom-0 pb-3" style="font-weight: 500;">MÓN ĂN</th>
                                            <th class="text-center border-top-0 border-bottom-0 pb-3" style="font-weight: 500;">SL</th>
                                            <th class="text-end pe-0 border-top-0 border-bottom-0 pb-3" style="font-weight: 500;">THÀNH TIỀN</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in Model.ChiTietMonAn)
                                        {
                                            <tr>
                                                <td class="ps-0 py-3">
                                                    <div class="d-flex align-items-center">
                                                        @if (!string.IsNullOrEmpty(item.HinhAnh))
                                                        {
                                                            string imagePath = item.HinhAnh.StartsWith("http") ? item.HinhAnh : (item.HinhAnh.StartsWith("~") ? item.HinhAnh : "~/images/monan/" + item.HinhAnh);
                                                            <img src="@Url.Content(imagePath)" alt="@item.TenMon" class="rounded-3 me-3" style="width: 54px; height: 54px; object-fit: cover;" />
                                                        }
                                                        else
                                                        {
                                                            <div class="rounded-3 bg-light d-flex align-items-center justify-content-center me-3" style="width: 54px; height: 54px;">
                                                                <span class="text-muted small">Ảnh</span>
                                                            </div>
                                                        }
                                                        <div>
                                                            <div class="fw-bold text-dark">@item.TenMon</div>
                                                            <div class="text-muted small">@String.Format("{0:N0} đ", item.DonGia)</div>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-center py-3 fw-bold text-dark">x@(item.SoLuong)</td>
                                                <td class="text-end pe-0 py-3 fw-bold text-dark">@String.Format("{0:N0} đ", item.ThanhTien)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            
                            <div class="d-flex justify-content-between mb-3 text-muted" style="font-size: 0.95rem;">
                                <span>Tổng tiền món</span>
                                <span class="fw-bold text-dark">@String.Format("{0:N0} đ", Model.TongTien ?? 0)</span>
                            </div>
                            <div class="d-flex justify-content-between mb-4 pb-4 border-bottom">
                                <span class="text-success fw-bold">Thu nhập (Phí ship)</span>
                                <span class="text-success fw-bold fs-5">+@String.Format("{0:N0} đ", Model.ShipFee)</span>
                            </div>
                            
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="text-uppercase fw-bold text-dark" style="letter-spacing: 1px; font-size: 0.85rem;">TỔNG THU</span>
                                <span class="fw-bold text-dark fs-3">@String.Format("{0:N0} đ", (Model.TongTien ?? 0) + Model.ShipFee)</span>
                            </div>
                        }
                        
                    </div>
                </div>
            }

            @if (Model != null && string.IsNullOrEmpty(Model.MaShipper))
            {
                <div class="mt-4 text-center">
                    @using (Html.BeginForm("Accept", "Shipper", FormMethod.Post))
                    {
                        <input type="hidden" name="maDon" value="@Model.MaDon" />
                        <button type="submit" class="btn btn-dark btn-lg w-100 fw-bold" style="border-radius: 50px; padding: 14px;">
                            NHẬN ĐƠN NÀY
                        </button>
                    }
                </div>
            }
            
            @if (Model != null && !string.IsNullOrEmpty(Model.MaShipper))
            {
                <div class="d-grid gap-2 mt-4">
                    <button class="btn btn-outline-primary btn-lg" style="border-radius: 50px; padding: 14px;" onclick="openChat('KH_@Model.MaKH', 'Khách hàng @(Model.KhachHang?.TenKH)', '@Model.MaDon')">
                        <i class="bi bi-chat-dots-fill"></i> Chat với Khách hàng
                    </button>
                    <button class="btn btn-outline-success btn-lg" style="border-radius: 50px; padding: 14px;" onclick="openChat('NH_@Model.MaNH', 'Nhà hàng @(Model.NhaHang?.TenNH)', '@Model.MaDon')">
                        <i class="bi bi-chat-dots-fill"></i> Chat với Nhà hàng
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    @if (Model != null && Model.NhaHang != null && Model.KhachHang != null && !string.IsNullOrEmpty(Model.MaShipper))
    {
        <!-- Leaflet CSS -->
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.css" />

        <!-- Leaflet JS -->
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script src="https://unpkg.com/leaflet-routing-machine@3.2.12/dist/leaflet-routing-machine.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var map = L.map('map').setView([10.762622, 106.660172], 13);

                // Add OpenStreetMap tiles
                L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap contributors',
                    maxZoom: 19
                }).addTo(map);

                var originStr = '@HttpUtility.JavaScriptStringEncode(Model.NhaHang.DiaChi)';
                var destinationStr = '@HttpUtility.JavaScriptStringEncode(Model.KhachHang.DiaChi)';

                // Function to geocode address using Nominatim (Free)
                async function geocode(address) {
                    try {
                        const response = await fetch('https://nominatim.openstreetmap.org/search?format=json&q=' + encodeURIComponent(address));
                        const data = await response.json();
                        if (data && data.length > 0) {
                            return L.latLng(data[0].lat, data[0].lon);
                        }
                    } catch (error) {
                        console.error('Geocoding error:', error);
                    }
                    return null;
                }

                // Show loading text
                document.getElementById('map').innerHTML = '<div style="display:flex;justify-content:center;align-items:center;height:100%;"><p>Đang tải dữ liệu đường đi...</p></div>';

                async function initRouting() {
                    const originLatLng = await geocode(originStr);
                    const destLatLng = await geocode(destinationStr);

                    // Xóa chữ Đang tải
                    document.getElementById('map').innerHTML = '';

                    // Nếu không tìm thấy tọa độ thì báo lỗi nhẹ
                    if (!originLatLng || !destLatLng) {
                        document.getElementById('map').innerHTML = '<div style="display:flex;justify-content:center;align-items:center;height:100%;color:red;text-align:center;"><p>Không thể định vị chính xác địa chỉ trên bản đồ.<br/>Vui lòng xem địa chỉ bằng chữ phía trên.</p></div>';
                        return;
                    }

                    // Re-init map after clearing innerHTML
                    map.remove();
                    map = L.map('map');
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        attribution: '© OpenStreetMap contributors',
                        maxZoom: 19
                    }).addTo(map);

                    L.Routing.control({
                        waypoints: [
                            originLatLng,
                            destLatLng
                        ],
                        routeWhileDragging: false,
                        show: false, // Ẩn cái bảng hướng dẫn text đi cho gọn
                        addWaypoints: false,
                        draggableWaypoints: false,
                        fitSelectedRoutes: true,
                        showAlternatives: false,
                        lineOptions: {
                            styles: [{color: '#0d6efd', opacity: 0.8, weight: 6}]
                        },
                        createMarker: function(i, wp, nWps) {
                            // Tùy chỉnh icon (0 = điểm bắt đầu, 1 = điểm kết thúc)
                            let markerColor = i === 0 ? 'red' : 'green';
                            let markerIcon = L.divIcon({
                                className: 'custom-div-icon',
                                html: `<div style="background-color:${markerColor};width:16px;height:16px;border-radius:50%;border:2px solid white;box-shadow:0 0 4px rgba(0,0,0,0.5);"></div>`,
                                iconSize: [16, 16],
                                iconAnchor: [8, 8]
                            });
                            return L.marker(wp.latLng, {icon: markerIcon});
                        }
                    }).addTo(map);
                }

                initRouting();
            });
        </script>
    }
}