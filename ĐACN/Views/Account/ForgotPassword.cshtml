@model ĐACN.TaiKhoan

@{
    ViewBag.Title = "Quên mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quên Mật Khẩu - TapFood</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --primary-color: #ff4757;
            --primary-hover: #ff6b81;
            --bg-color: #f1f2f6;
            --text-color: #2f3542;
            --card-bg: #ffffff;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-color);
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            color: var(--text-color);
        }

        .forgot-container {
            background-color: var(--card-bg);
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            overflow: hidden;
            width: 100%;
            max-width: 450px;
            padding: 40px;
            box-sizing: border-box;
        }

        .header {
            text-align: center;
            margin-bottom: 30px;
        }

        .header h1 {
            color: var(--primary-color);
            font-size: 28px;
            margin-bottom: 10px;
        }

        .header p {
            color: #747d8c;
            font-size: 14px;
        }

        .form-group {
            margin-bottom: 20px;
            position: relative;
        }

        .form-group i {
            position: absolute;
            top: 50%;
            left: 15px;
            transform: translateY(-50%);
            color: #a4b0be;
        }

        .form-control {
            width: 100%;
            padding: 12px 15px 12px 45px;
            border: 1px solid #dfe4ea;
            border-radius: 8px;
            font-size: 14px;
            box-sizing: border-box;
            transition: all 0.3s ease;
        }

        .form-control:focus {
            border-color: var(--primary-color);
            outline: none;
            box-shadow: 0 0 0 3px rgba(255, 71, 87, 0.1);
        }

        .btn-primary {
            width: 100%;
            padding: 12px;
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .btn-primary:hover {
            background-color: var(--primary-hover);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #747d8c;
            text-decoration: none;
            font-size: 14px;
            transition: color 0.3s ease;
        }

        .back-link:hover {
            color: var(--primary-color);
        }

        .step {
            display: none;
            animation: fadeIn 0.5s ease;
        }

        .step.active {
            display: block;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .spinner {
            display: none;
            width: 20px;
            height: 20px;
            border: 3px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: white;
            animation: spin 1s ease-in-out infinite;
            margin: 0 auto;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="forgot-container">
        <!-- Bước 1: Nhập Email -->
        <div id="step-1" class="step active">
            <div class="header">
                <h1>Quên mật khẩu?</h1>
                <p>Nhập email đăng nhập của bạn, chúng tôi sẽ gửi mã xác nhận OTP.</p>
            </div>
            <div class="form-group">
                <i class="fas fa-envelope"></i>
                <input type="email" id="email" class="form-control" placeholder="Nhập địa chỉ Email" required>
            </div>
            <button id="btnSendOTP" class="btn-primary">
                <span class="btn-text">Gửi mã OTP</span>
                <div class="spinner"></div>
            </button>
            <a href="/Account/Login" class="back-link"><i class="fas fa-arrow-left"></i> Quay lại đăng nhập</a>
        </div>

        <!-- Bước 2: Nhập OTP -->
        <div id="step-2" class="step">
            <div class="header">
                <h1>Xác nhận OTP</h1>
                <p>Mã OTP đã được gửi đến email <strong id="displayEmail"></strong></p>
            </div>
            <div class="form-group">
                <i class="fas fa-key"></i>
                <input type="text" id="otpCode" class="form-control" placeholder="Nhập mã 6 số" maxlength="6" required>
            </div>
            <button id="btnVerifyOTP" class="btn-primary">Xác nhận</button>
            <a href="javascript:void(0)" id="btnResendOTP" class="back-link">Gửi lại mã?</a>
        </div>

        <!-- Bước 3: Đặt mật khẩu mới -->
        <div id="step-3" class="step">
            <div class="header">
                <h1>Mật khẩu mới</h1>
                <p>Vui lòng nhập mật khẩu mới cho tài khoản của bạn.</p>
            </div>
            <div class="form-group">
                <i class="fas fa-lock"></i>
                <input type="password" id="newPassword" class="form-control" placeholder="Mật khẩu mới" required>
            </div>
            <div class="form-group">
                <i class="fas fa-lock"></i>
                <input type="password" id="confirmPassword" class="form-control" placeholder="Xác nhận mật khẩu" required>
            </div>
            <button id="btnResetPassword" class="btn-primary">Đổi mật khẩu</button>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            let currentEmail = "";

            // Bước 1: Gửi OTP
            $("#btnSendOTP").click(function () {
                var email = $("#email").val().trim();
                if (!email) {
                    Swal.fire('Lỗi', 'Vui lòng nhập email!', 'error');
                    return;
                }

                var btn = $(this);
                btn.find('.btn-text').hide();
                btn.find('.spinner').css('display', 'block');
                btn.prop('disabled', true);

                $.post("/Account/SendOTP", { email: email }, function (res) {
                    btn.find('.btn-text').show();
                    btn.find('.spinner').hide();
                    btn.prop('disabled', false);

                    if (res.success) {
                        currentEmail = email;
                        $("#displayEmail").text(email);
                        $("#step-1").removeClass("active");
                        $("#step-2").addClass("active");
                        Swal.fire('Thành công', res.message, 'success');
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                });
            });

            // Bước 2: Xác nhận OTP
            $("#btnVerifyOTP").click(function () {
                var otp = $("#otpCode").val().trim();
                if (!otp || otp.length !== 6) {
                    Swal.fire('Lỗi', 'Vui lòng nhập đủ 6 số OTP!', 'error');
                    return;
                }

                $.post("/Account/VerifyOTP", { email: currentEmail, otp: otp }, function (res) {
                    if (res.success) {
                        $("#step-2").removeClass("active");
                        $("#step-3").addClass("active");
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                });
            });

            // Gửi lại OTP
            $("#btnResendOTP").click(function () {
                $("#email").val(currentEmail);
                $("#btnSendOTP").click();
            });

            // Bước 3: Đổi mật khẩu
            $("#btnResetPassword").click(function () {
                var newPassword = $("#newPassword").val();
                var confirmPassword = $("#confirmPassword").val();

                if (!newPassword || newPassword.length < 6) {
                    Swal.fire('Lỗi', 'Mật khẩu phải có ít nhất 6 ký tự!', 'error');
                    return;
                }

                if (newPassword !== confirmPassword) {
                    Swal.fire('Lỗi', 'Mật khẩu xác nhận không khớp!', 'error');
                    return;
                }

                $.post("/Account/ResetPassword", { email: currentEmail, newPassword: newPassword }, function (res) {
                    if (res.success) {
                        Swal.fire({
                            title: 'Thành công',
                            text: 'Đổi mật khẩu thành công! Chuyển tới trang đăng nhập...',
                            icon: 'success',
                            timer: 2000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.href = "/Account/Login";
                        });
                    } else {
                        Swal.fire('Lỗi', res.message, 'error');
                    }
                });
            });
        });
    </script>
</body>
</html>
