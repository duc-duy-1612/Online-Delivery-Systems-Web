        function updateFullAddressNH() {
            var street = $("#streetNH").val().trim();
            var wardText = $("#wardNH option:selected").text();
            var districtText = $("#districtNH option:selected").text();
            var cityText = $("#cityNH option:selected").text();

            var fullAddress = "";
            if (street) fullAddress += street;
