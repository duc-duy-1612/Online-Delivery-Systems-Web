            $("#diaChiNH").val(fullAddress);
        }

        

        function submitRegister() {
            var formData = new FormData();
            var token = $('input[name="__RequestVerificationToken"]').val();

            if (selectedRole === 'KhachHang') {
                var password = $('#passwordKH').val();
                var confirmPassword = $('#confirmPasswordKH').val();

                if (password !== confirmPassword) {
                    $("#registerError").text("Mật khẩu xác nhận không khớp!").show();
                    return;
                }


                var fullAddress = $('#diaChiKH').val();
                if (!fullAddress || fullAddress.trim() === "") {
                    $("#registerError").text("Vui lòng chọn đầy đủ Tỉnh/Thành, Quận/Huyện, Phường/Xã và nhập số nhà, tên đường!").show();
                    return;
                }

                formData.append('role', 'KhachHang');
                formData.append('username', $('#usernameKH').val());
                formData.append('password', password);
                formData.append('tenKH', $('#tenKH').val());
                formData.append('sdt', $('#sdtKH').val());
                formData.append('diaChi', fullAddress);
                formData.append('__RequestVerificationToken', token);
            }
            else if (selectedRole === 'NhaHang') {
                var password = $('#passwordNH').val();
                var confirmPassword = $('#confirmPasswordNH').val();

                if (password !== confirmPassword) {
                    $("#registerError").text("Mật khẩu xác nhận không khớp!").show();
                    return;
                }


                var fullAddress = $('#diaChiNH').val();
                if (!fullAddress || fullAddress.trim() === "") {
                    $("#registerError").text("Vui lòng chọn đầy đủ Tỉnh/Thành, Quận/Huyện, Phường/Xã và nhập số nhà, tên đường!").show();
                    return;
                }

                var fileInput = $('#hinhAnhNH')[0];
                if (fileInput.files.length > 0) {
                    formData.append('hinhAnhFile', fileInput.files[0]);
                }

                formData.append('role', 'NhaHang');
                formData.append('username', $('#usernameNH').val());
                formData.append('password', password);
                formData.append('tenNH', $('#tenNH').val());
                formData.append('diaChi', fullAddress);
                formData.append('sdt', $('#sdtNH').val());
                formData.append('__RequestVerificationToken', token);
            }
            else if (selectedRole === 'Shipper') {
                var password = $('#passwordShipper').val();
                var confirmPassword = $('#confirmPasswordShipper').val();

                if (password !== confirmPassword) {
                    $("#registerError").text("Mật khẩu xác nhận không khớp!").show();
                    return;
                }

                var fileInput = $('#hinhAnhShipper')[0];
                if (fileInput.files.length > 0) {
                    formData.append('hinhAnhFile', fileInput.files[0]);
                }

                formData.append('role', 'Shipper');
                formData.append('username', $('#usernameShipper').val());
                formData.append('password', password);
                formData.append('tenShipper', $('#tenShipper').val());
                formData.append('sdt', $('#sdtShipper').val());
                formData.append('bienSoXe', $('#bienSoXe').val());
                formData.append('__RequestVerificationToken', token);
            }

            $.ajax({
                url: '/Account/Register',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (res) {
                    if (res && res.success) {
                        $("#registerError").hide();
                        var message = res.message || "Đăng ký thành công!";
                        if (typeof Antigravity !== 'undefined') {
                            Antigravity.celebrate({ palette: 'tapfood', duration: 2000, particleCount: 80 });
                        }

                        if (selectedRole === "NhaHang" || selectedRole === "Shipper") {
                            if (confirm(message + "\n\nBạn đã đăng ký thành công nhưng cần chờ Admin xác nhận.\n\nBạn có muốn quay lại trang đăng nhập không?")) {
                                window.location.href = '/Account/Login';
                            }
                        } else {
                            $("#registerSuccess").text(message).show();
                            setTimeout(function () {
                                window.location.href = '/Account/Login';
                            }, 2000);
                        }
                    } else {
                        $("#registerSuccess").hide();
                        $("#registerError").text(res.message || "Có lỗi xảy ra, vui lòng thử lại.").show();
                    }
                },
                error: function (xhr) {
                    $("#registerSuccess").hide();
                    var errorMsg = "Có lỗi xảy ra, vui lòng thử lại.";
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    $("#registerError").text(errorMsg).show();
                }
            });
        }
        // Google Identity Services callback for Register
        function handleGoogleRegisterCredential(response) {
            $.ajax({
                url: '/Account/GoogleLogin',
                type: 'POST',
                data: { credential: response.credential },
                success: function (res) {
                    if (res.success) {
                        if (typeof Antigravity !== 'undefined') {
                            Antigravity.celebrate({ palette: 'tapfood', duration: 1500 });
                        }
                        if (res.isNew) {
                            alert('Đăng ký thành công bằng Google! Chào mừng bạn đến với TapFood.');
                        }
                        window.location.href = '/Home/TrangChu';
                    } else {
                        $("#registerError").text(res.message).show();
                    }
                },
                error: function () {
                    $("#registerError").text("Có lỗi xảy ra khi đăng ký bằng Google.").show();
                }
            });
        }

        // Initialize Google Sign-In for Register
        window.addEventListener('load', function() {
            if (typeof google !== 'undefined' && google.accounts) {
                google.accounts.id.initialize({
                    client_id: '@googleClientId',
                    callback: handleGoogleRegisterCredential
                });
                var regBtn = document.getElementById('googleRegisterBtnContainer');
                if (regBtn) {
                    google.accounts.id.renderButton(
                        regBtn,
                        {
                            theme: 'outline',
                            size: 'large',
                            width: 300,
                            text: 'signup_with',
                            shape: 'rectangular',
                            logo_alignment: 'left'
                        }
                    );
                }
            }
            // Khởi tạo hiệu ứng Antigravity cho cột thương hiệu bên trái
            if (typeof Antigravity !== 'undefined') {
                new Antigravity('#registerLeftPanel', {
                    palette: 'tapfood',
                    particleCount: 35,
                    opacity: 0.85,
                    gravity: -0.04,
                    speed: 0.7,
                    interactive: true,
                    zIndex: 1
                });
            }
        });
    </script>
    <script src="@Url.Content("~/Scripts/antigravity/antigravity.js")"></script>
</body>
