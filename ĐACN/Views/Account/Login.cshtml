@{
    Layout = null;
    string googleClientId = System.Configuration.ConfigurationManager.AppSettings["Google:ClientId"];
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - TapFood</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body, html { min-height: 100vh; font-family: 'Inter', 'Segoe UI', sans-serif; }

    .split-screen { display: flex; min-height: 100vh; align-items: stretch; }

    /* ===== LEFT SIDE - Food Image + Brand ===== */
    .left-side {
        flex: 1.1;
        background: linear-gradient(135deg, rgba(0,0,0,0.7) 0%, rgba(0,0,0,0.3) 100%),
                    url('https://images.unsplash.com/photo-1504674900247-0877df9cc836?q=80&w=2070') center/cover;
        color: white;
        display: flex; flex-direction: column;
        justify-content: center;
        padding: 60px 10%;
        position: relative;
        text-align: left;
        overflow: hidden;
    }
    .left-side::before {
        content: '';
        position: absolute; top: -30%; left: -20%;
        width: 160%; height: 180%;
        background: radial-gradient(circle at 40% 60%, rgba(255,159,28,0.2) 0%, transparent 55%);
        pointer-events: none;
    }
    .left-brand {
        position: relative; z-index: 1;
    }
    .left-brand h1 {
        font-size: 2.8rem; font-weight: 900; letter-spacing: -1px;
        text-shadow: 0 4px 20px rgba(0,0,0,0.3);
        margin-bottom: 1rem;
    }
    .left-brand p {
        font-size: 1.15rem; opacity: 0.9;
        font-weight: 400; line-height: 1.6;
        max-width: 320px;
    }
    .left-brand .features {
        margin-top: 2.5rem; display: flex; flex-direction: column; gap: 12px;
        text-align: left;
    }
    .left-brand .feature-item {
        display: flex; align-items: center; gap: 12px;
        font-size: 0.95rem; opacity: 0.9;
    }
    .left-brand .feature-icon {
        width: 36px; height: 36px; border-radius: 10px;
        background: rgba(255,255,255,0.15);
        display: flex; align-items: center; justify-content: center;
        font-size: 1rem; flex-shrink: 0;
    }

    /* ===== RIGHT SIDE - Login Form ===== */
    .right-side {
        flex: 0.9;
        display: flex; flex-direction: column;
        justify-content: center; align-items: center;
        background: #f8f9fa;
        padding: 48px 40px;
        position: relative;
    }

    .login-card {
        width: 100%; max-width: 380px;
    }
    .login-card h2 {
        font-size: 1.9rem; font-weight: 800; color: #1a202c;
        margin-bottom: 0.4rem; letter-spacing: -0.5px;
    }
    .login-card .subtitle { color: #718096; font-size: 0.95rem; margin-bottom: 2rem; }

    /* ===== FORM ===== */
    .form-label { font-weight: 600; font-size: 0.88rem; color: #4a5568; margin-bottom: 6px; }
    .form-control {
        border-radius: 0.85rem;
        padding: 0.75rem 1rem;
        border: 1.5px solid #e2e8f0;
        background: #fff;
        color: #2d3748;
        font-size: 0.95rem;
        transition: all 0.25s ease;
    }
    .form-control:focus {
        border-color: #ff5a2b;
        box-shadow: 0 0 0 3px rgba(255,90,43,0.12);
        background: #fff;
        color: #1a202c;
        outline: none;
    }
    .form-control::placeholder { color: #a0aec0; }

    /* ===== GRADIENT BUTTON ===== */
    .btn-gradient {
        background: linear-gradient(135deg, #ff5a2b 0%, #ff9f1c 100%);
        border: none; color: white;
        padding: 0.85rem 1rem;
        border-radius: 0.85rem;
        font-weight: 700; font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 6px 18px rgba(255,90,43,0.3);
        letter-spacing: 0.3px;
    }
    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 26px rgba(255,90,43,0.4);
        color: white;
    }
    .btn-gradient:active { transform: translateY(0); }

    /* ===== GOOGLE BUTTON ===== */
    .btn-google {
        background: #fff; border: 1.5px solid #e2e8f0;
        color: #2d3748; padding: 0.75rem 1rem;
        border-radius: 0.85rem; font-weight: 600;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .btn-google:hover { border-color: #cbd5e0; background: #f7fafc; transform: translateY(-1px); }

    /* ===== DIVIDER ===== */
    .divider { display: flex; align-items: center; gap: 12px; color: #a0aec0; font-size: 0.85rem; margin: 1rem 0; }
    .divider::before, .divider::after { content: ''; flex: 1; height: 1px; background: #e2e8f0; }

    /* ===== LINKS ===== */
    .text-gradient {
        background: linear-gradient(135deg, #ff5a2b, #ff9f1c);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        font-weight: 700;
    }

    /* ===== BACK HOME ===== */
    .back-home {
        position: absolute; top: 20px; right: 24px;
        text-decoration: none; color: #718096; font-weight: 500;
        font-size: 0.88rem; display: flex; align-items: center; gap: 6px;
        transition: color 0.2s;
    }
    .back-home:hover { color: #ff5a2b; }

    /* ===== ALERT ===== */
    #loginError {
        background: #fff5f5; border: 1px solid #fecaca;
        color: #c53030; border-radius: 0.75rem; font-size: 0.9rem;
        padding: 0.75rem 1rem;
    }

    @@media (max-width: 768px) {
        .left-side { display: none; }
        .split-screen { display: block; }
        .right-side { min-height: 100vh; padding: 40px 24px; }
    }
</style>
</head>
<body>
    <a href="@Url.Action("TrangChu", "Home")" class="back-home"><i class="fa-solid fa-house"></i> Về trang chủ</a>
    <div class="split-screen">
        <div class="left-side" id="loginLeftPanel">
            <div style="position: relative; z-index: 2;">
                <h1 class="mb-4" style="font-family: 'Playfair Display', serif; font-size: 3.5rem; font-weight: 700; display: flex; align-items: center;">
                    <img src="@Url.Content("~/images/logo.png")" alt="TapFood" style="height: 64px; margin-right: 16px; object-fit: contain;" />
                    <span>Tap<span style="color: var(--primary-color);">Food</span></span>
                </h1>
                <p style="font-size: 1.15rem; font-weight: 300; line-height: 1.6; opacity: 0.9; margin-bottom: 2.5rem; max-width: 420px;">
                    Hương vị tuyệt hảo — giao đến tận cửa, siêu tốc và tiện lợi mỗi ngày.
                </p>
                <div style="font-size: 1.05rem; font-weight: 300; opacity: 0.8; line-height: 2;">
                    &bull; &nbsp;Giao hàng trong 30 phút<br/>
                    &bull; &nbsp;Hàng trăm nhà hàng đối tác<br/>
                    &bull; &nbsp;Thanh toán an toàn bảo mật
                </div>
            </div>
        </div>
        <div class="right-side">
            <div class="login-card">
                <h2>Chào mừng trở lại!</h2><p class="subtitle">Đăng nhập để khám phá ẩm thực tuyệt vời 🎉</p>
                

                <form id="formLogin" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="username" class="form-label fw-semibold">Tên đăng nhập</label>
                        <input type="text" name="username" id="username" class="form-control" placeholder="Nhập tên đăng nhập" required />
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label fw-semibold">Mật khẩu</label>
                        <input type="password" name="password" id="password" class="form-control" placeholder="Nhập mật khẩu" required />
                    </div>

                    <div id="loginError" class="alert alert-danger text-center" style="display:none; border-radius:10px;"></div>

                    <button type="submit" class="btn btn-gradient w-100 mb-3 mt-2">Đăng nhập</button>

                    <div class="divider">hoặc</div>

                    <div id="googleBtnContainer" style="display:flex; justify-content:center;"></div>

                    <div class="text-center">
                        <a href="/Account/ForgotPassword" class="text-decoration-none text-muted mb-2 d-block">Quên mật khẩu?</a>
                        <span class="text-muted">Chưa có tài khoản?</span> <a href="/Account/Register" class="text-decoration-none text-gradient">Đăng ký ngay</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script>
        // Google Identity Services callback
        function handleGoogleCredential(response) {
            $.ajax({
                url: '/Account/GoogleLogin',
                type: 'POST',
                data: { credential: response.credential },
                success: function (res) {
                    if (res.success) {
                        if (res.role === "Shipper") {
                            window.location.href = '/Shipper/Index';
                        } else if (res.role === "Admin") {
                            window.location.href = '/Admin/DanhSachCuaHang';
                        } else if (res.role === "NhaHang") {
                            window.location.href = '/NhaHang/ThongKe';
                        } else {
                            window.location.href = '/Home/TrangChu';
                        }
                    } else {
                        $("#loginError").text(res.message).show();
                    }
                },
                error: function () {
                    $("#loginError").text("Có lỗi xảy ra khi đăng nhập Google.").show();
                }
            });
        }

        // Initialize Google Sign-In
        window.addEventListener('load', function() {
            if (typeof google !== 'undefined' && google.accounts) {
                google.accounts.id.initialize({
                    client_id: '@googleClientId',
                    callback: handleGoogleCredential
                });
                google.accounts.id.renderButton(
                    document.getElementById('googleBtnContainer'),
                    {
                        theme: 'outline',
                        size: 'large',
                        width: 380,
                        text: 'signin_with',
                        shape: 'rectangular',
                        logo_alignment: 'left'
                    }
                );
            }
        });

        $(document).ready(function () {
            // Khởi tạo hiệu ứng Antigravity cho cột thương hiệu bên trái
            if (typeof Antigravity !== 'undefined') {
                new Antigravity('#loginLeftPanel', {
                    palette: 'tapfood',
                    particleCount: 35,
                    opacity: 0.85,
                    gravity: -0.04,
                    speed: 0.7,
                    interactive: true,
                    zIndex: 1
                });
            }

            $("#formLogin").submit(function (e) {
                e.preventDefault();

                var username = $("#username").val();
                var password = $("#password").val();
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/Account/Login',
                    type: 'POST',
                    data: {
                        username: username,
                        password: password,
                        __RequestVerificationToken: token
                    },
                    success: function (res) {
                        if (res.success) {
                            if (typeof Antigravity !== 'undefined') {
                                Antigravity.celebrate({ palette: 'tapfood', duration: 1200, particleCount: 70 });
                            }
                            setTimeout(function () {
                                if (res.role === "Shipper") {
                                    window.location.href = '/Shipper/Index';
                                } else if (res.role === "Admin") {
                                    window.location.href = '/Admin/DanhSachCuaHang';
                                } else if (res.role === "NhaHang") {
                                    window.location.href = '/NhaHang/ThongKe';
                                } else {
                                    window.location.href = '/Home/TrangChu';
                                }
                            }, 400);
                        } else {
                            $("#loginError").text(res.message).show();
                        }
                    },
                    error: function () {
                        $("#loginError").text("Có lỗi xảy ra. Vui lòng thử lại.").show();
                    }
                });
            });
        });
    </script>
    <script src="@Url.Content("~/Scripts/antigravity/antigravity.js")"></script>
</body>
</html>