@model ĐACN.Models.MonAnTheoLoaiViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Thế Giới " + (Model.LoaiMonAn != null ? Model.LoaiMonAn.TenLoai : "Món Ăn");
    var tatCaLoai = ViewBag.TatCaLoai as List<ĐACN.Models.LoaiMonAnViewModel>;
    var count = Model.NhaHang != null ? Model.NhaHang.Count() : 0;
    var categoryImg = string.IsNullOrEmpty(Model.LoaiMonAn?.HinhAnh)
        ? Url.Content("~/images/danhmuc/com.png")
        : Url.Content("~/images/danhmuc/" + Model.LoaiMonAn.HinhAnh);
}

<style>
    /* Category Page Styles - Luxury Dark Theme */
    .category-hero {
        position: relative;
        background: radial-gradient(circle at 50% 20%, rgba(212, 175, 55, 0.12) 0%, rgba(28, 31, 30, 0.95) 70%, #121413 100%);
        border: 1px solid rgba(212, 175, 55, 0.2);
        border-radius: 24px;
        padding: 40px 24px 30px;
        margin-top: 25px;
        margin-bottom: 35px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.6);
        overflow: hidden;
    }

    .category-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(212, 175, 55, 0.05) 0%, transparent 60%);
        pointer-events: none;
    }

    .breadcrumb-custom {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        font-size: 0.88rem;
        color: #a0aec0;
        margin-bottom: 20px;
    }

    .breadcrumb-custom a {
        color: #cbd5e0;
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .breadcrumb-custom a:hover {
        color: var(--primary-color, #d4af37);
    }

    .breadcrumb-custom .active {
        color: var(--primary-color, #d4af37);
        font-weight: 600;
    }

    .category-avatar-wrapper {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 18px;
    }

    .category-avatar {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid var(--primary-color, #d4af37);
        box-shadow: 0 0 25px rgba(212, 175, 55, 0.4);
        background: #1c1f1e;
        transition: transform 0.4s ease;
    }

    .category-hero:hover .category-avatar {
        transform: scale(1.05) rotate(4deg);
    }

    .category-title {
        font-family: 'Playfair Display', serif;
        font-size: clamp(1.8rem, 4vw, 2.6rem);
        font-weight: 700;
        color: #f8f9fa;
        margin-bottom: 10px;
        background: linear-gradient(135deg, #fff 20%, #d4af37 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.5px;
    }

    .category-desc {
        color: #a0aec0;
        font-size: 0.98rem;
        max-width: 620px;
        margin: 0 auto 20px;
        line-height: 1.6;
    }

    .category-tags {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 12px;
    }

    .category-tag {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: #e2e8f0;
        font-size: 0.82rem;
        font-weight: 500;
        padding: 6px 14px;
        border-radius: 30px;
        backdrop-filter: blur(8px);
    }

    .category-tag.highlight {
        background: rgba(212, 175, 55, 0.15);
        border-color: rgba(212, 175, 55, 0.4);
        color: #f3e5ab;
    }

    /* Category Quick Switcher */
    .category-pills-bar {
        display: flex;
        gap: 10px;
        overflow-x: auto;
        padding: 8px 4px 18px;
        margin-bottom: 25px;
        scrollbar-width: thin;
        scrollbar-color: rgba(212, 175, 55, 0.3) transparent;
    }

    .category-pills-bar::-webkit-scrollbar {
        height: 5px;
    }

    .category-pills-bar::-webkit-scrollbar-thumb {
        background: rgba(212, 175, 55, 0.3);
        border-radius: 4px;
    }

    .cat-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        background: var(--bg-card, #1C1F1E);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 40px;
        color: #cbd5e0;
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 600;
        white-space: nowrap;
        transition: all 0.3s ease;
    }

    .cat-pill img {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        object-fit: cover;
    }

    .cat-pill:hover {
        background: rgba(212, 175, 55, 0.12);
        color: var(--primary-color, #d4af37);
        border-color: rgba(212, 175, 55, 0.4);
        transform: translateY(-2px);
    }

    .cat-pill.active {
        background: linear-gradient(135deg, var(--primary-color, #d4af37), #b5952f);
        color: #121413;
        border-color: var(--primary-color, #d4af37);
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.35);
    }

    /* Section Subheading */
    .section-header-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .section-header-bar h4 {
        margin: 0;
        font-size: 1.3rem;
        font-weight: 700;
        color: #f8f9fa;
    }

    .result-count {
        color: #a0aec0;
        font-size: 0.9rem;
    }

    /* Restaurant Card Styling */
    .restaurant-card {
        background: var(--bg-card, #1C1F1E);
        border: 1px solid rgba(255, 255, 255, 0.07);
        border-radius: 18px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
        transition: all 0.35s cubic-bezier(0.25, 0.8, 0.25, 1);
        position: relative;
    }

    .restaurant-card:hover {
        transform: translateY(-8px);
        border-color: rgba(212, 175, 55, 0.45);
        box-shadow: 0 16px 36px rgba(212, 175, 55, 0.16);
        color: inherit;
        text-decoration: none;
    }

    .restaurant-img-wrapper {
        position: relative;
        width: 100%;
        padding-top: 62%;
        overflow: hidden;
        background: #242827;
    }

    .restaurant-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease;
    }

    .restaurant-card:hover .restaurant-img {
        transform: scale(1.08);
    }

    .restaurant-overlay-gradient {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 45%;
        background: linear-gradient(to top, rgba(28, 31, 30, 0.9), transparent);
        pointer-events: none;
    }

    .card-badge {
        position: absolute;
        top: 12px;
        padding: 5px 11px;
        border-radius: 20px;
        font-size: 0.78rem;
        font-weight: 700;
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        z-index: 3;
        display: inline-flex;
        align-items: center;
        gap: 4px;
    }

    .badge-rating {
        left: 12px;
        background: rgba(18, 20, 19, 0.85);
        color: #f8f9fa;
        border: 1px solid rgba(212, 175, 55, 0.35);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
    }

    .badge-rating i {
        color: #ffc107;
    }

    .badge-status-open {
        right: 12px;
        background: rgba(16, 185, 129, 0.2);
        color: #34d399;
        border: 1px solid rgba(52, 211, 153, 0.35);
    }

    .badge-status-open::before {
        content: '';
        width: 6px;
        height: 6px;
        background: #34d399;
        border-radius: 50%;
        box-shadow: 0 0 6px #34d399;
    }

    .badge-status-closed {
        right: 12px;
        background: rgba(239, 68, 68, 0.25);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.4);
    }

    .closed-overlay-backdrop {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(18, 20, 19, 0.75);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2;
        backdrop-filter: blur(2px);
    }

    .closed-overlay-backdrop span {
        background: rgba(220, 38, 38, 0.9);
        color: #fff;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 0.82rem;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(220, 38, 38, 0.4);
    }

    .restaurant-body {
        padding: 16px 18px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .restaurant-title {
        font-weight: 700;
        font-size: 1.12rem;
        color: #f8f9fa;
        margin-bottom: 6px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: color 0.2s ease;
    }

    .restaurant-card:hover .restaurant-title {
        color: var(--primary-color, #d4af37);
    }

    .restaurant-address {
        font-size: 0.84rem;
        color: #a0aec0;
        margin-bottom: 14px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .restaurant-address i {
        color: var(--primary-color, #d4af37);
        flex-shrink: 0;
    }

    .restaurant-meta {
        margin-top: auto;
        padding-top: 12px;
        border-top: 1px solid rgba(255, 255, 255, 0.07);
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 0.86rem;
    }

    .stat-sold {
        color: #cbd5e0;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .cta-menu {
        color: var(--primary-color, #d4af37);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: transform 0.2s ease;
    }

    .restaurant-card:hover .cta-menu {
        transform: translateX(4px);
    }

    /* Empty State */
    .empty-state-card {
        background: var(--bg-card, #1C1F1E);
        border: 1px dashed rgba(212, 175, 55, 0.3);
        border-radius: 20px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .empty-icon-circle {
        width: 90px;
        height: 90px;
        border-radius: 50%;
        background: rgba(212, 175, 55, 0.1);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 20px;
        color: var(--primary-color, #d4af37);
        font-size: 2.5rem;
    }

    .empty-state-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #f8f9fa;
        margin-bottom: 8px;
    }

    .empty-state-text {
        color: #a0aec0;
        max-width: 460px;
        margin: 0 auto 24px;
        font-size: 0.95rem;
    }

    .btn-return-home {
        background: linear-gradient(135deg, var(--primary-color, #d4af37), #b5952f);
        color: #121413;
        font-weight: 700;
        padding: 10px 28px;
        border-radius: 30px;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(212, 175, 55, 0.3);
    }

    .btn-return-home:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(212, 175, 55, 0.45);
        color: #121413;
        text-decoration: none;
    }
</style>

<div class="container pb-5">
    <!-- Breadcrumb -->
    <div class="breadcrumb-custom mt-3">
        <a href="@Url.Action("TrangChu", "Home")"><i class="fas fa-home me-1"></i> Trang chủ</a>
        <span>/</span>
        <a href="@Url.Action("TrangChu", "Home")#category-section">Danh mục</a>
        <span>/</span>
        <span class="active">@Model.LoaiMonAn.TenLoai</span>
    </div>

    <!-- Category Hero Header -->
    <div class="category-hero text-center" data-aos="fade-down">
        <div class="category-avatar-wrapper">
            <img src="@categoryImg" alt="@Model.LoaiMonAn.TenLoai" class="category-avatar" onerror="this.onerror=null; this.src='@Url.Content("~/images/danhmuc/com.png")'" />
        </div>
        <h1 class="category-title">Thế Giới @Model.LoaiMonAn.TenLoai</h1>
        <p class="category-desc">
            Khám phá những nhà hàng, quán ăn phục vụ món @Model.LoaiMonAn.TenLoai chuẩn vị hảo hạng, được chế biến thơm ngon và giao hàng siêu tốc tận nơi.
        </p>
        <div class="category-tags">
            <span class="category-tag highlight">
                <i class="fas fa-store"></i> @count Nhà hàng phục vụ
            </span>
            <span class="category-tag">
                <i class="fas fa-bolt text-warning"></i> Giao siêu tốc 20-30 phút
            </span>
            <span class="category-tag">
                <i class="fas fa-shield-halved text-success"></i> Đảm bảo chất lượng 100%
            </span>
        </div>
    </div>

    <!-- Category Quick Switcher Pills -->
    @if (tatCaLoai != null && tatCaLoai.Any())
    {
        <div class="category-pills-bar" data-aos="fade-up">
            @foreach (var cat in tatCaLoai)
            {
                var isActive = cat.MaLoai == Model.LoaiMonAn.MaLoai;
                var pillImg = string.IsNullOrEmpty(cat.HinhAnh)
                    ? Url.Content("~/images/danhmuc/com.png")
                    : Url.Content("~/images/danhmuc/" + cat.HinhAnh);

                <a href="@Url.Action("MonAnTheoLoai", "KhachHang", new { maLoai = cat.MaLoai })"
                   class="cat-pill @(isActive ? "active" : "")"
                   title="@cat.TenLoai">
                    <img src="@pillImg" alt="@cat.TenLoai" onerror="this.onerror=null; this.src='@Url.Content("~/images/danhmuc/com.png")'" />
                    <span>@cat.TenLoai</span>
                </a>
            }
        </div>
    }

    <!-- Restaurant Section Header -->
    <div class="section-header-bar" data-aos="fade-up">
        <h4><i class="fas fa-utensils me-2" style="color: var(--primary-color);"></i> Danh sách nhà hàng</h4>
        <span class="result-count">Tìm thấy <strong class="text-warning">@count</strong> địa điểm</span>
    </div>

    <!-- Restaurant Content -->
    @if (Model.NhaHang == null || !Model.NhaHang.Any())
    {
        <div class="empty-state-card" data-aos="fade-up">
            <div class="empty-icon-circle">
                <i class="fas fa-utensils"></i>
            </div>
            <h3 class="empty-state-title">Chưa có nhà hàng nào phục vụ món @Model.LoaiMonAn.TenLoai</h3>
            <p class="empty-state-text">
                Các đối tác ẩm thực đang chuẩn bị món ăn hấp dẫn này. Hãy thử khám phá các danh mục ẩm thực khác ngay bên dưới nhé!
            </p>
            <a href="@Url.Action("TrangChu", "Home")" class="btn-return-home">
                <i class="fas fa-arrow-left"></i> Khám phá danh mục khác
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" data-aos="fade-up">
            @foreach (var nh in Model.NhaHang)
            {
                var isClosed = nh.TrangThai == "Đang đóng cửa";
                var restaurantImgSrc = string.IsNullOrEmpty(nh.HinhAnh)
                    ? Url.Content("~/images/nhahang/comtam_saigon.jpg")
                    : (nh.HinhAnh.StartsWith("http") ? nh.HinhAnh : Url.Content("~/images/nhahang/" + nh.HinhAnh));

                <div class="col">
                    <a href="@Url.Action("XemMenu", "KhachHang", new { id = nh.MaNH })" class="restaurant-card">
                        <div class="restaurant-img-wrapper">
                            <img src="@restaurantImgSrc"
                                 alt="@nh.TenNH"
                                 class="restaurant-img"
                                 onerror="this.onerror=null; this.src='@Url.Content("~/images/nhahang/comtam_saigon.jpg")'" />
                            <div class="restaurant-overlay-gradient"></div>

                            <!-- Rating Badge -->
                            <div class="card-badge badge-rating">
                                <i class="fas fa-star"></i>
                                <span>@(nh.Rating > 0 ? nh.Rating.ToString("0.0") : "5.0")</span>
                            </div>

                            <!-- Status Badge -->
                            @if (isClosed)
                            {
                                <div class="card-badge badge-status-closed">
                                    <i class="fas fa-door-closed"></i> Tạm đóng
                                </div>
                                <div class="closed-overlay-backdrop">
                                    <span>Tạm ngưng nhận đơn</span>
                                </div>
                            }
                            else
                            {
                                <div class="card-badge badge-status-open">
                                    <span>Đang mở</span>
                                </div>
                            }
                        </div>

                        <div class="restaurant-body">
                            <h5 class="restaurant-title" title="@nh.TenNH">@nh.TenNH</h5>
                            <p class="restaurant-address" title="@nh.DiaChi">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>@(string.IsNullOrEmpty(nh.DiaChi) ? "TP. Hồ Chí Minh" : nh.DiaChi)</span>
                            </p>
                            <div class="restaurant-meta">
                                <div class="stat-sold">
                                    <i class="fas fa-fire text-warning"></i>
                                    <span>@(nh.TongLuotMua) đã bán</span>
                                </div>
                                <div class="cta-menu">
                                    <span>Xem menu</span>
                                    <i class="fas fa-chevron-right"></i>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>
