@{
    ViewBag.Title = "Cài đặt tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { background: #f8f9fa; font-family: 'Inter', sans-serif; }
    .card { border: 1px solid rgba(0,0,0,0.07) !important; border-radius: 1rem !important; box-shadow: 0 4px 16px rgba(0,0,0,0.06) !important; }
    .card-header { border-bottom: 1px solid rgba(0,0,0,0.06) !important; background: #fff !important; }
    h4.fw-bold, h5.fw-bold, h3.fw-bold { color: #1a202c !important; }
    .text-muted { color: #718096 !important; }
    .btn-primary { background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; color: #fff !important; }
    .btn-primary:hover { box-shadow: 0 6px 18px rgba(255,90,43,0.35) !important; }
    .btn-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-secondary { border-radius: 0.75rem !important; font-weight: 600 !important; }
    .form-control, .form-select { border-radius: 0.75rem !important; border: 1.5px solid #e2e8f0 !important; background: #f7fafc !important; color: #2d3748 !important; transition: all 0.2s; }
    .form-control:focus, .form-select:focus { background: #fff !important; border-color: #ff5a2b !important; box-shadow: 0 0 0 3px rgba(255,90,43,0.12) !important; }
    .table thead th { background: #f8fafc !important; color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #e2e8f0 !important; }
    .table tbody tr:hover { background: #fffaf8 !important; }
    .table td { border-color: #f0f2f5 !important; vertical-align: middle; }
    .badge.bg-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; color: #fff !important; }
    .badge.bg-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; }
    .badge.bg-warning { background: linear-gradient(135deg, #f59e0b, #d97706) !important; color: #fff !important; }
    .badge.bg-info    { background: linear-gradient(135deg, #3b82f6, #2563eb) !important; color: #fff !important; }
    .alert { border-radius: 0.85rem !important; }
    .alert-success { background: #d1fae5 !important; color: #065f46 !important; border: 1px solid #a7f3d0 !important; }
    .alert-danger  { background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fecaca !important; }
    .alert-info    { background: #dbeafe !important; color: #1e40af !important; border: 1px solid #93c5fd !important; }
    .alert-warning { background: #fef3c7 !important; color: #92400e !important; border: 1px solid #fde68a !important; }
    label { color: #4a5568 !important; font-weight: 600; }
</style>


<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            @if (TempData["Msg"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 mb-4 rounded-3" role="alert">
                    <i class="fas fa-bell me-2 text-warning"></i> @TempData["Msg"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <h3 class="mb-4 fw-bold text-dark text-center"><i class="fas fa-cog text-secondary me-2"></i>Cài đặt tài khoản</h3>

            <div class="card settings-card mb-5">
                <div class="card-header bg-white pt-4 pb-2 border-bottom-0">
                    <h5 class="card-title text-primary fw-bold mb-0"><i class="fas fa-shield-alt me-2"></i>Đổi mật khẩu</h5>
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("DoiMatKhau", "KhachHang", FormMethod.Post))
                    {
                        <div class="position-relative mb-4">
                            <div class="form-floating">
                                <input type="password" class="form-control" id="matKhauCu" name="matKhauCu" placeholder="Mật khẩu hiện tại" required>
                                <label for="matKhauCu">Mật khẩu hiện tại</label>
                            </div>
                            <i class="fas fa-eye password-toggle" onclick="togglePassword('matKhauCu', this)"></i>
                        </div>

                        <div class="position-relative mb-2">
                            <div class="form-floating">
                                <input type="password" class="form-control" id="matKhauMoi" name="matKhauMoi" placeholder="Mật khẩu mới" minlength="6" required>
                                <label for="matKhauMoi">Mật khẩu mới</label>
                            </div>
                            <i class="fas fa-eye password-toggle" onclick="togglePassword('matKhauMoi', this)"></i>
                        </div>
                        <div class="form-text text-muted small ms-2 mb-4"><i class="fas fa-info-circle me-1"></i>Mật khẩu cần tối thiểu 6 ký tự.</div>

                        <div class="position-relative mb-4">
                            <div class="form-floating">
                                <input type="password" class="form-control" id="xacNhanMatKhau" name="xacNhanMatKhau" placeholder="Xác nhận mật khẩu mới" required>
                                <label for="xacNhanMatKhau">Xác nhận mật khẩu mới</label>
                            </div>
                            <i class="fas fa-eye password-toggle" onclick="togglePassword('xacNhanMatKhau', this)"></i>
                        </div>

                        <div class="d-grid mt-2">
                            <button type="submit" class="btn btn-update">
                                <i class="fas fa-key me-2"></i>Cập nhật mật khẩu
                            </button>
                        </div>
                    }
                </div>
            </div>

            <div class="card settings-card danger-zone">
                <div class="card-body p-4">
                    <h5 class="card-title text-danger fw-bold"><i class="fas fa-exclamation-triangle me-2"></i>Vùng nguy hiểm</h5>
                    <p class="card-text text-muted small mb-4">
                        Việc xóa tài khoản sẽ vô hiệu hóa hoàn toàn quyền truy cập của bạn. Lịch sử đơn hàng sẽ được ẩn danh hoặc loại bỏ. 
                        <strong>Hành động này không thể hoàn tác!</strong>
                    </p>

                    @using (Html.BeginForm("XoaTaiKhoan", "KhachHang", FormMethod.Post, new { id = "formXoaTaiKhoan" }))
                    {
                        <div class="d-grid">
                            <button type="button" class="btn btn-danger-action" onclick="confirmDelete()">
                                <i class="fas fa-trash-alt me-2"></i>Xóa tài khoản vĩnh viễn
                            </button>
                        </div>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<script>
    function togglePassword(inputId, iconElement) {
        var input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
            iconElement.classList.remove("fa-eye");
            iconElement.classList.add("fa-eye-slash");
        } else {
            input.type = "password";
            iconElement.classList.remove("fa-eye-slash");
            iconElement.classList.add("fa-eye");
        }
    }

    function confirmDelete() {
        Swal.fire({
            title: 'CẢNH BÁO TỐI CAO',
            text: "Bạn có chắc chắn muốn xóa tài khoản này không? Hành động này không thể khôi phục!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Đồng ý xóa',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById('formXoaTaiKhoan').submit();
            }
        });
    }
</script>
