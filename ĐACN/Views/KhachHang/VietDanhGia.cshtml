@model ĐACN.Models.DanhGiaViewModel

@{
    ViewBag.Title = "Đánh giá đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    body { background: #f8f9fa; font-family: 'Inter', sans-serif; }
    .card { border: 1px solid rgba(0,0,0,0.07) !important; border-radius: 1rem !important; box-shadow: 0 4px 16px rgba(0,0,0,0.06) !important; }
    .card-header { border-bottom: 1px solid rgba(0,0,0,0.06) !important; background: #fff !important; }
    h4.fw-bold, h5.fw-bold, h3.fw-bold { color: #1a202c !important; }
    .text-muted { color: #718096 !important; }
    .btn-primary { background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; color: #fff !important; }
    .btn-primary:hover { box-shadow: 0 6px 18px rgba(255,90,43,0.35) !important; }
    .btn-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-secondary { border-radius: 0.75rem !important; font-weight: 600 !important; }
    .form-control, .form-select { border-radius: 0.75rem !important; border: 1.5px solid #e2e8f0 !important; background: #f7fafc !important; color: #2d3748 !important; transition: all 0.2s; }
    .form-control:focus, .form-select:focus { background: #fff !important; border-color: #ff5a2b !important; box-shadow: 0 0 0 3px rgba(255,90,43,0.12) !important; }
    .table thead th { background: #f8fafc !important; color: #64748b; font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #e2e8f0 !important; }
    .table tbody tr:hover { background: #fffaf8 !important; }
    .table td { border-color: #f0f2f5 !important; vertical-align: middle; }
    .badge.bg-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; color: #fff !important; }
    .badge.bg-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; }
    .badge.bg-warning { background: linear-gradient(135deg, #f59e0b, #d97706) !important; color: #fff !important; }
    .badge.bg-info    { background: linear-gradient(135deg, #3b82f6, #2563eb) !important; color: #fff !important; }
    .alert { border-radius: 0.85rem !important; }
    .alert-success { background: #d1fae5 !important; color: #065f46 !important; border: 1px solid #a7f3d0 !important; }
    .alert-danger  { background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fecaca !important; }
    .alert-info    { background: #dbeafe !important; color: #1e40af !important; border: 1px solid #93c5fd !important; }
    .alert-warning { background: #fef3c7 !important; color: #92400e !important; border: 1px solid #fde68a !important; }
    label { color: #4a5568 !important; font-weight: 600; }
</style>


<div class="container mt-5 mb-5">
    <div class="review-container">
        @using (Html.BeginForm("LuuDanhGia", "KhachHang", FormMethod.Post, new { id = "formDanhGia" }))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.MaDon)
            @Html.HiddenFor(m => m.MaNH)
            @Html.HiddenFor(m => m.MaShipper)

            <!-- BƯỚC 1: Đánh giá nhà hàng -->
            <div id="step-nhahang" class="step-section active">
                <div class="card card-review">
                    <div class="card-review-header">
                        <h3 class="mb-1 fw-bold">Đánh giá món ăn</h3>
                        <p class="mb-0 opacity-75">Chia sẻ trải nghiệm của bạn với nhà hàng này</p>
                    </div>
                    <div class="card-body text-center pt-0 px-4 pb-4">
                        <img src="~/Content/Images/restaurant-icon.png" alt="Restaurant" class="avatar-lg mb-3" onerror="this.src='https://ui-avatars.com/api/?name=NH&background=0D8ABC&color=fff&size=100'" />
                        <h4 class="fw-bold text-dark mb-4">@Model.TenNH</h4>

                        <div class="mb-4">
                            @Html.HiddenFor(m => m.SoSaoNhaHang, new { id = "ratingInputNH" })
                            <div class="d-flex justify-content-center" id="star-container-nh">
                                <i class="fas fa-star rating-star selected" data-value="1"></i>
                                <i class="fas fa-star rating-star selected" data-value="2"></i>
                                <i class="fas fa-star rating-star selected" data-value="3"></i>
                                <i class="fas fa-star rating-star selected" data-value="4"></i>
                                <i class="fas fa-star rating-star selected" data-value="5"></i>
                            </div>
                            <div class="mt-3 fs-5 text-warning fw-bold" id="rating-text-nh">Tuyệt vời</div>
                        </div>

                        <div class="mb-4 text-start">
                            <label class="fw-bold mb-2 text-secondary">Chi tiết đánh giá (Tùy chọn)</label>
                            @Html.TextAreaFor(m => m.BinhLuanNhaHang, new { @class = "form-control review-textarea", rows = "3", placeholder = "Món ăn hương vị thế nào? Hãy chia sẻ nhé..." })
                        </div>

                        <div class="d-grid gap-3">
                            <button type="button" class="btn btn-primary btn-action btn-lg shadow-sm" onclick="nextStep()">
                                Tiếp tục đánh giá tài xế <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                            <button type="button" class="btn-skip" onclick="nextStep()">Để sau, bỏ qua bước này</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BƯỚC 2: Đánh giá shipper -->
            <div id="step-shipper" class="step-section">
                <div class="card card-review">
                    <div class="card-review-header" style="background: linear-gradient(135deg, #198754 0%, #20c997 100%);">
                        <h3 class="mb-1 fw-bold">Đánh giá tài xế</h3>
                        <p class="mb-0 opacity-75">Đội ngũ giao hàng rất mong nhận được góp ý từ bạn</p>
                    </div>
                    
                    <div class="card-body text-center pt-0 px-4 pb-4">
                        @if (!string.IsNullOrEmpty(Model.MaShipper))
                        {
                            <img src="~/Content/Images/shipper-icon.png" alt="Shipper" class="avatar-lg mb-3" onerror="this.src='https://ui-avatars.com/api/?name=TX&background=198754&color=fff&size=100'" />
                            <h4 class="fw-bold text-dark mb-4">@Model.TenShipper</h4>

                            <div class="mb-4">
                                @Html.HiddenFor(m => m.SoSaoShipper, new { id = "ratingInputShipper" })
                                <div class="d-flex justify-content-center" id="star-container-shipper">
                                    <i class="fas fa-star rating-star selected" data-value="1"></i>
                                    <i class="fas fa-star rating-star selected" data-value="2"></i>
                                    <i class="fas fa-star rating-star selected" data-value="3"></i>
                                    <i class="fas fa-star rating-star selected" data-value="4"></i>
                                    <i class="fas fa-star rating-star selected" data-value="5"></i>
                                </div>
                                <div class="mt-3 fs-5 text-warning fw-bold" id="rating-text-shipper">Tuyệt vời</div>
                            </div>

                            <div class="mb-4 text-start">
                                <label class="fw-bold mb-2 text-secondary">Chi tiết đánh giá (Tùy chọn)</label>
                                @Html.TextAreaFor(m => m.BinhLuanShipper, new { @class = "form-control review-textarea", rows = "3", placeholder = "Tài xế có thân thiện không? Giao hàng nhanh không?" })
                            </div>

                            <div class="d-grid gap-3 mt-4">
                                <button type="submit" class="btn btn-success btn-action btn-lg shadow-sm">
                                    <i class="fas fa-check-circle me-2"></i> Hoàn tất & Gửi đánh giá
                                </button>
                                <button type="button" class="btn-skip" onclick="redirectToHome()">Đóng và về Trang chủ</button>
                            </div>
                        }
                        else
                        {
                            <div class="mt-5 mb-4">
                                <div class="alert alert-info border-0 shadow-sm rounded-3">
                                    <i class="fas fa-info-circle me-2"></i> Đơn hàng này không có thông tin tài xế để đánh giá.
                                </div>
                            </div>
                            <div class="d-grid gap-3">
                                <button type="submit" class="btn btn-success btn-action btn-lg shadow-sm">
                                    <i class="fas fa-paper-plane me-2"></i> Gửi đánh giá Nhà hàng
                                </button>
                                <button type="button" class="btn-skip" onclick="redirectToHome()">Hủy và về Trang chủ</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<script>
    function setupStarRating(containerId, inputId, textId) {
        const stars = document.querySelectorAll(`#${containerId} .rating-star`);
        const input = document.getElementById(inputId);
        const textLabel = document.getElementById(textId);
        const labels = ["Rất tệ", "Không hài lòng", "Bình thường", "Hài lòng", "Tuyệt vời"];

        stars.forEach(star => {
            star.addEventListener('click', function () {
                const value = this.getAttribute('data-value');
                input.value = value;

                stars.forEach(s => {
                    s.classList.remove('pop');
                    if (s.getAttribute('data-value') <= value) {
                        s.classList.add('selected');
                    } else {
                        s.classList.remove('selected');
                    }
                });
                
                // Add pop animation to the clicked star
                this.classList.add('pop');
                setTimeout(() => this.classList.remove('pop'), 400);

                textLabel.textContent = labels[value - 1];
                
                // Optional color change based on rating
                if(value <= 2) {
                    textLabel.className = "mt-3 fs-5 fw-bold text-danger";
                } else if(value == 3) {
                    textLabel.className = "mt-3 fs-5 fw-bold text-info";
                } else {
                    textLabel.className = "mt-3 fs-5 fw-bold text-warning";
                }
            });
            
            // Hover effects
            star.addEventListener('mouseenter', function() {
                const value = this.getAttribute('data-value');
                stars.forEach(s => {
                    if (s.getAttribute('data-value') <= value) {
                        s.style.opacity = '1';
                        s.style.transform = 'scale(1.1)';
                    } else {
                        s.style.opacity = '0.5';
                    }
                });
            });
            
            star.addEventListener('mouseleave', function() {
                stars.forEach(s => {
                    s.style.opacity = '1';
                    s.style.transform = 'scale(1)';
                });
            });
        });
    }

    document.addEventListener("DOMContentLoaded", function() {
        setupStarRating('star-container-nh', 'ratingInputNH', 'rating-text-nh');
        setupStarRating('star-container-shipper', 'ratingInputShipper', 'rating-text-shipper');
    });

    function nextStep() {
        const step1 = document.getElementById('step-nhahang');
        const step2 = document.getElementById('step-shipper');
        
        step1.style.opacity = '0';
        step1.style.transform = 'translateY(-20px)';
        
        setTimeout(() => {
            step1.classList.remove('active');
            step2.classList.add('active');
            
            // Force reflow
            void step2.offsetWidth;
            
            step2.style.opacity = '1';
            step2.style.transform = 'translateY(0)';
        }, 400);
    }

    function redirectToHome() {
        Swal.fire({
            title: 'Bạn có chắc chắn?',
            text: "Bạn sẽ thoát mà không gửi đánh giá?",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#d33',
            cancelButtonColor: '#3085d6',
            confirmButtonText: 'Có, thoát',
            cancelButtonText: 'Không'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = '@Url.Action("TrangChu", "Home")';
            }
        });
    }
</script>
