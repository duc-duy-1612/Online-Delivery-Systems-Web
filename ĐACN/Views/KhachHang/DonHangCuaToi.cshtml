@model ĐACN.Models.DonHangTongHopViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Đơn hàng của tôi";
}

<style>
    /* ===== DON HANG CUA TOI - PREMIUM ===== */
    body { background: #f8f9fa; font-family: 'Inter', sans-serif; }

    /* ===== PAGE HEADER ===== */
    .order-page-header {
        background: linear-gradient(135deg, #ff5a2b 0%, #ff9f1c 100%);
        color: white;
        padding: 3rem 0;
        margin-bottom: 2rem;
        border-radius: 0 0 2.5rem 2.5rem;
        box-shadow: 0 10px 35px rgba(255, 90, 43, 0.3);
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .order-page-header::before {
        content: '';
        position: absolute; top: -60%; left: -20%;
        width: 150%; height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 60%);
        pointer-events: none;
    }
    .order-page-header h1 { font-weight: 800; font-size: 2rem; }

    /* ===== CUSTOM TABS ===== */
    .custom-tabs {
        border-bottom: none; gap: 12px;
        justify-content: center; margin-bottom: 2rem;
    }
    .custom-tabs .nav-link {
        border: 1.5px solid #e2e8f0 !important;
        background: #fff; color: #718096;
        border-radius: 30px; padding: 10px 28px;
        font-weight: 700;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        transition: all 0.25s ease;
    }
    .custom-tabs .nav-link:hover {
        border-color: #ff5a2b !important;
        color: #ff5a2b;
        transform: translateY(-2px);
        box-shadow: 0 6px 16px rgba(255,90,43,0.15);
    }
    .custom-tabs .nav-link.active {
        background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important;
        border-color: transparent !important;
        color: #fff !important;
        box-shadow: 0 8px 20px rgba(255, 90, 43, 0.35);
    }

    /* ===== ORDER CARD ===== */
    .order-card {
        background: #fff;
        border-radius: 1.25rem;
        border: 1px solid rgba(0,0,0,0.06);
        padding: 1.5rem;
        margin-bottom: 1.25rem;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        transition: all 0.25s ease;
        position: relative;
        overflow: hidden;
    }
    .order-card::before {
        content: '';
        position: absolute; left: 0; top: 0; bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #ff5a2b, #ff9f1c);
        border-radius: 4px 0 0 4px;
        opacity: 0;
        transition: opacity 0.25s ease;
    }
    .order-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(0,0,0,0.09); }
    .order-card:hover::before { opacity: 1; }

    .order-header {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 1rem; padding-bottom: 1rem;
        border-bottom: 1px dashed #e9ecef;
    }

    .order-id { font-weight: 800; color: #1a202c; font-size: 1.05rem; }
    .order-time { color: #718096; font-size: 0.88rem; margin-top: 3px; }
    .order-total { font-size: 1.3rem; font-weight: 800; color: #ff5a2b; }

    /* ===== STATUS BADGES ===== */
    .status-badge { padding: 6px 14px; border-radius: 20px; font-weight: 700; font-size: 0.82rem; }
    .status-cho-xac-nhan { background: #f1f5f9; color: #64748b; }
    .status-dang-lay-mon { background: #dbeafe; color: #1e40af; }
    .status-dang-giao    { background: #fef3c7; color: #92400e; }
    .status-hoan-thanh   { background: #d1fae5; color: #065f46; }
    .status-da-huy       { background: #fee2e2; color: #991b1b; }

    /* ===== ACTION BUTTON ===== */
    .btn-order-action {
        border-radius: 0.75rem; padding: 8px 20px; font-weight: 600;
        background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important;
        border: none !important; color: #fff !important;
        transition: all 0.2s;
        box-shadow: 0 4px 12px rgba(255,90,43,0.25);
    }
    .btn-order-action:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(255,90,43,0.35) !important; }

    /* ===== EMPTY STATE ===== */
    .empty-state {
        background: #fff; border-radius: 1.5rem; padding: 4rem 2rem; text-align: center;
        border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
    }

    /* ===== RESTAURANT NAME ===== */
    .restaurant-name { font-weight: 700; color: #2d3748; }
    .items-preview { color: #718096; font-size: 0.9rem; }
</style>

<div class="order-page-header">
    <div class="container">
        <h1 class="fw-bold mb-2"><i class="fas fa-clipboard-list me-3"></i>Đơn Hàng Của Tôi</h1>
        <p class="mb-0 opacity-75 fs-5">Theo dõi hành trình những bữa ăn ngon của bạn</p>
    </div>
</div>

<div class="container mb-5">
    <ul class="nav nav-tabs custom-tabs" id="orderTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" id="processing-tab" data-bs-toggle="tab" data-bs-target="#processing" type="button">
                <i class="fas fa-motorcycle me-2"></i>Đang xử lý
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="history-tab" data-bs-toggle="tab" data-bs-target="#history" type="button">
                <i class="fas fa-history me-2"></i>Lịch sử đơn hàng
            </button>
        </li>
    </ul>

    <div class="tab-content mt-4">
        <!-- TAB ĐANG XỬ LÝ -->
        <div class="tab-pane fade show active" id="processing">
            @if (Model == null || Model.DonHangDangXuLy == null || !Model.DonHangDangXuLy.Any())
            {
                <div class="empty-state">
                    <img src="https://cdn-icons-png.flaticon.com/512/2748/2748558.png" style="width:120px; opacity:0.5" class="mb-4" />
                    <h4 class="fw-bold mb-3" style="color:#1a202c">Chưa có đơn hàng nào đang xử lý</h4>
                    <p class="text-muted mb-0">Hãy đặt món để lấp đầy chiếc bụng đói nhé!</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-lg-2 g-4">
                    @foreach (var item in Model.DonHangDangXuLy)
                    {
                        string badgeClass = "status-cho-xac-nhan";
                        if (item.TrangThai == "Đang lấy món") { badgeClass = "status-dang-lay-mon"; }
                        else if (item.TrangThai == "Đang giao") { badgeClass = "status-dang-giao"; }
                        
                        <div class="col">
                            <div class="order-card">
                                <div class="order-header">
                                    <div>
                                        <div class="order-id"><i class="fas fa-hashtag text-muted me-1"></i>@item.MaDon</div>
                                        <div class="order-time"><i class="far fa-clock me-1"></i>@(item.ThoiGianDat?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                                    </div>
                                    <span class="status-badge @badgeClass">@item.TrangThai</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2">
                                    <div>
                                        <div class="text-muted small fw-bold mb-1">TỔNG TIỀN</div>
                                        <div class="order-total">@String.Format("{0:N0}₫", item.TongTien)</div>
                                    </div>
                                    <a href="@Url.Action("TheoDoiDonHang", "KhachHang", new { maDon = item.MaDon })" class="btn btn-order-action">
                                        Theo dõi đơn <i class="fas fa-arrow-right ms-2"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- TAB LỊCH SỬ -->
        <div class="tab-pane fade" id="history">
            @if (Model == null || Model.LichSuDonHang == null || !Model.LichSuDonHang.Any())
            {
                <div class="empty-state">
                    <img src="https://cdn-icons-png.flaticon.com/512/2748/2748558.png" style="width:120px; opacity:0.5" class="mb-4" />
                    <h4 class="fw-bold mb-3" style="color:#1a202c">Lịch sử đơn hàng trống</h4>
                    <p class="text-muted mb-0">Những kỷ niệm ăn uống của bạn sẽ xuất hiện ở đây.</p>
                </div>
            }
            else
            {
                <div class="row row-cols-1 row-cols-lg-2 g-4">
                    @foreach (var item in Model.LichSuDonHang)
                    {
                        string badgeClass = item.TrangThai == "Hoàn thành" ? "status-hoan-thanh" : "status-da-huy";
                        
                        <div class="col">
                            <div class="order-card">
                                <div class="order-header">
                                    <div>
                                        <div class="order-id"><i class="fas fa-hashtag text-muted me-1"></i>@item.MaDon</div>
                                        <div class="order-time"><i class="far fa-clock me-1"></i>@(item.ThoiGianDat?.ToString("dd/MM/yyyy HH:mm") ?? "-")</div>
                                    </div>
                                    <span class="status-badge @badgeClass">@item.TrangThai</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center pt-2">
                                    <div>
                                        <div class="text-muted small fw-bold mb-1">TỔNG TIỀN</div>
                                        <div class="order-total text-dark">@String.Format("{0:N0}₫", item.TongTien)</div>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <a href="@Url.Action("TheoDoiDonHang", "KhachHang", new { maDon = item.MaDon })" class="btn btn-light btn-order-action border">
                                            Chi tiết
                                        </a>
                                        @if (item.TrangThai == "Hoàn thành")
                                        {
                                            <button class="btn btn-warning text-dark btn-order-action shadow-sm" onclick="moDanhGiaNhaHang('@item.MaDon')">
                                                <i class="fas fa-star me-1"></i> Đánh giá
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<script>
    function moDanhGiaNhaHang(maDon) {
        $.getJSON('/KhachHang/LayThongTinDanhGiaNhaHang?maDon=' + maDon, function(response) {
            if (response.success && response.danhGia) {
                var danhGia = response.danhGia;
                
                $('#ratingNHMaDon').val(danhGia.maDon);
                $('#ratingNHMaNH').val(danhGia.maNH);
                $('#ratingNHMaDonDisplay').text(danhGia.maDon);
                $('#ratingNHTenNhaHang').text(danhGia.tenNhaHang);
                $('#ratingNHThoiGian').text(danhGia.thoiGian);
                
                if (danhGia.soSaoCu) {
                    $('#ratingNHSoSao').val(danhGia.soSaoCu);
                    $('#ratingNHSoSaoDisplay').text(danhGia.soSaoCu);
                    
                    if (typeof currentRatingNH !== 'undefined') {
                        currentRatingNH = danhGia.soSaoCu;
                    }
                    $('.rating-nh-star').each(function () {
                        var rating = $(this).data('rating');
                        if (rating <= danhGia.soSaoCu) {
                            $(this).addClass('active');
                            $(this).css('filter', 'none');
                            $(this).css('opacity', '1');
                        } else {
                            $(this).removeClass('active');
                            $(this).css('filter', 'grayscale(100%)');
                            $(this).css('opacity', '0.3');
                        }
                    });
                    $('#btnLuuDanhGiaNH').prop('disabled', false);
                } else {
                    if (typeof currentRatingNH !== 'undefined') {
                        currentRatingNH = 0;
                    }
                    $('#ratingNHSoSao').val(0);
                    $('#ratingNHSoSaoDisplay').text('0');
                    $('.rating-nh-star').removeClass('active').css('filter', 'grayscale(100%)').css('opacity', '0.3');
                    $('#btnLuuDanhGiaNH').prop('disabled', true);
                }
                
                if (danhGia.binhLuanCu) {
                    $('#ratingNHBinhLuan').val(danhGia.binhLuanCu);
                } else {
                    $('#ratingNHBinhLuan').val('');
                }
                
                $('#danhGiaNhaHangModal').removeData('already-processed');
                $('#danhGiaNhaHangModal').data('from-history-page', true); // Đánh dấu là từ lịch sử
                $('#danhGiaNhaHangModal').removeData('saved-success');
                if (typeof isProcessingNH !== 'undefined') {
                    isProcessingNH = false;
                }
                
                $('#btnLuuDanhGiaNH').off('click').on('click', function() {
                    var maDon = $('#ratingNHMaDon').val();
                    var maNH = $('#ratingNHMaNH').val();
                    var soSao = parseInt($('#ratingNHSoSao').val());
                    var binhLuan = $('#ratingNHBinhLuan').val();

                    if (soSao < 1 || soSao > 5) {
                        Swal.fire({ icon: 'warning', title: 'Thiếu thông tin', text: 'Vui lòng chọn số sao từ 1 đến 5!' });
                        return;
                    }

                    var token = $('input[name="__RequestVerificationToken"]').val();

                    $.ajax({
                        url: '/KhachHang/LuuDanhGiaNhaHang',
                        type: 'POST',
                        data: {
                            maDon: maDon,
                            maNH: maNH,
                            soSao: soSao,
                            binhLuan: binhLuan,
                            __RequestVerificationToken: token
                        },
                        success: function (response) {
                            if (response.success) {
                                $('#danhGiaNhaHangModal').data('saved-success', true);
                                $('#danhGiaNhaHangModal').data('already-processed', true);
                                if (typeof isProcessingNH !== 'undefined') {
                                    isProcessingNH = true;
                                }
                                
                                var modal = bootstrap.Modal.getInstance(document.getElementById('danhGiaNhaHangModal'));
                                if (modal) modal.hide();
                            } else {
                                Swal.fire({ icon: 'error', title: 'Lỗi', text: response.message || 'Có lỗi xảy ra khi lưu đánh giá!' });
                            }
                        },
                        error: function () {
                            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra khi gửi đánh giá. Vui lòng thử lại!' });
                        }
                    });
                });
                
                var modal = new bootstrap.Modal(document.getElementById('danhGiaNhaHangModal'));
                modal.show();
            } else {
                Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Không thể tải thông tin đơn hàng!' });
            }
        }).fail(function() {
            Swal.fire({ icon: 'error', title: 'Lỗi', text: 'Có lỗi xảy ra khi tải thông tin!' });
        });
    }
    
    $(document).ready(function() {
        $('#danhGiaNhaHangModal').on('hidden.bs.modal', function() {
            var isFromHistory = $(this).data('from-history-page');
            if (isFromHistory && $(this).data('saved-success')) {
                location.reload();
            }
        });
    });
</script>