<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Shipper Dashboard</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/trangchu.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        html {
            font-size: 13px; /* Scales down all Bootstrap rem units to ~81% */
        }
        body {
            background-color: #f4f6f9;
            font-family: 'Outfit', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Sidebar */
        .sidebar {
            width: 210px;
            height: 100vh;
            background-color: #121418;
            position: fixed;
            top: 0;
            left: 0;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 4px 0 15px rgba(0,0,0,0.05);
            z-index: 1000;
            overflow-y: auto;
        }

        /* Tùy chỉnh thanh cuộn cho sidebar */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }

        .sidebar .brand {
            text-align: center;
            padding: 25px 0;
            font-size: 1.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sidebar-section {
            padding: 15px 0 5px 25px;
            font-size: 0.85rem;
            text-transform: uppercase;
            color: #6c757d;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .sidebar a {
            display: block;
            padding: 12px 20px;
            margin: 4px 15px;
            color: #a0a5ba;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            border-radius: 12px;
            font-weight: 500;
        }

        .sidebar a i {
            margin-right: 12px;
            font-size: 1.1rem;
            transition: transform 0.3s;
        }

        .sidebar a:hover {
            background-color: rgba(255,255,255,0.05);
            color: #fff;
            transform: translateX(5px);
        }

        .sidebar a.active {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            color: white;
            box-shadow: 0 4px 15px rgba(255, 75, 43, 0.4);
        }
        
        .sidebar a.active i {
            transform: scale(1.1);
        }

        .sidebar-footer {
            text-align: center;
            padding: 20px;
            font-size: 0.9rem;
            color: #888;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .sidebar-footer a {
            color: #ff4b2b;
            background: rgba(255, 75, 43, 0.1);
            border-radius: 50px;
            margin: 0;
            justify-content: center;
            display: flex;
            align-items: center;
        }
        
        .sidebar-footer a:hover {
            background: rgba(255, 75, 43, 0.2);
            color: #ff416c;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(255, 75, 43, 0.2);
        }

        /* Main content */
        .main-content {
            margin-left: 210px;
            padding: 24px;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border-radius: 16px;
            margin-bottom: 30px !important;
            padding: 15px 25px;
        }
        
        .navbar-brand {
            font-weight: 700;
            color: #2c3e50;
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <div>
            <div class="brand">Shipper</div>

            <div class="sidebar-section">Menu chính</div>
            <a href="@Url.Action("Index", "Shipper")" class="@(ViewBag.Active == "Index" ? "active" : "")">
                <i class="bi bi-inbox"></i> Đơn chờ nhận
            </a>
            <a href="@Url.Action("Accepted", "Shipper")" class="@(ViewBag.Active == "Accepted" ? "active" : "")">
                <i class="bi bi-check-circle"></i> Đơn đã nhận
            </a>
            <a href="@Url.Action("History", "Shipper")" class="@(ViewBag.Active == "History" ? "active" : "")">
                <i class="bi bi-calendar-check"></i> Lịch sử đơn
            </a>
            <a href="@Url.Action("Income", "Shipper")" class="@(ViewBag.Active == "Income" ? "active" : "")">
                <i class="bi bi-cash-stack"></i> Tổng thu nhập
            </a>

            <div class="sidebar-section">Tài khoản</div>
            <a href="@Url.Action("Profile", "Shipper")" class="@(ViewBag.Active == "Profile" ? "active" : "")">
                <i class="bi bi-person"></i> Thông tin cá nhân
            </a>
        </div>

        <div class="sidebar-footer">
            <a href="@Url.Action("TrangChu", "Home")" class="text-decoration-none mb-2" style="background: rgba(255, 255, 255, 0.1); color: #e5e7eb;">
                <i class="bi bi-house" style="margin-right: 8px;"></i> Về trang chủ
            </a>
            <a href="@Url.Action("Logout", "Shipper")" class="text-danger text-decoration-none">
                <i class="bi bi-box-arrow-right" style="margin-right: 8px;"></i> Đăng xuất
            </a>
            <div class="mt-3 text-muted">© 2025 TapFood Delivery</div>
        </div>
    </div>

    <div class="main-content">
        <nav class="navbar navbar-light mb-4">
            <div class="container-fluid">
                <span class="navbar-brand mb-0 h5">@ViewBag.Title</span>
            </div>
        </nav>

        @RenderBody()
    </div>

    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script src="https://cdnjs.cloudflare.com/ajax/libs/signalr.js/2.4.3/jquery.signalR.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script>
        $(function () {
            var hub = $.connection.deliveryHub;
            
            hub.client.notifyNewOrder = function (message) {
                Swal.fire({
                    icon: 'info',
                    title: 'Thông báo Shipper',
                    text: message,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true
                });
            };

            hub.client.pingOrder = function (maDon, distanceKm) {
                let timerInterval;
                Swal.fire({
                    title: '🔥 CÓ ĐƠN HÀNG MỚI! 🔥',
                    html: `<b>Mã đơn:</b> ${maDon}<br><b>Khoảng cách:</b> ${distanceKm} km<br><br> Tự động từ chối sau <b></b> giây.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'NHẬN ĐƠN',
                    cancelButtonText: 'Bỏ qua',
                    confirmButtonColor: '#ff416c',
                    timer: 15000,
                    timerProgressBar: true,
                    allowOutsideClick: false,
                    didOpen: () => {
                        const b = Swal.getHtmlContainer().querySelector('b:last-of-type');
                        timerInterval = setInterval(() => {
                            b.textContent = Math.ceil(Swal.getTimerLeft() / 1000);
                        }, 100);
                    },
                    willClose: () => {
                        clearInterval(timerInterval);
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Accept the order
                        var form = document.createElement('form');
                        form.method = 'POST';
                        form.action = '/Shipper/Accept';
                        var input = document.createElement('input');
                        input.type = 'hidden';
                        input.name = 'maDon';
                        input.value = maDon;
                        form.appendChild(input);
                        document.body.appendChild(form);
                        form.submit();
                    }
                });
            };

            $.connection.hub.start().done(function () {
                hub.server.joinGroup("Shippers");
                var maSP = '@Session["MaShipper"]';
                if (maSP) {
                    hub.server.joinGroup("Shipper_" + maSP);
                }
            });
        });
    </script>

    @Html.Partial("~/Views/Shared/_ChatWidget.cshtml")
    @RenderSection("Scripts", required: false)
</body>
</html>
