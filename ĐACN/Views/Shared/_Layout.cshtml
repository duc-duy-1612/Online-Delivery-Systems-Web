    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"></script>
    
    <!-- Google Sign-In for Modal -->
    <script>
        function handleGoogleModalCredential(response) {
            $.ajax({
                url: '/Account/GoogleLogin',
                type: 'POST',
                data: { credential: response.credential },
                success: function (res) {
                    if (res.success) {
                        var modal = bootstrap.Modal.getInstance(document.getElementById('loginModal'));
                        if (modal) modal.hide();
                        location.reload();
                    } else {
                        $('#loginError').text(res.message).show();
                    }
                },
                error: function () {
                    $('#loginError').text("Có lỗi xảy ra khi đăng nhập Google.").show();
                }
            });
        }

        window.addEventListener('load', function() {
            if (typeof google !== 'undefined' && google.accounts) {
                google.accounts.id.initialize({
                    client_id: '@googleClientId',
                    callback: handleGoogleModalCredential
                });
                var modalBtn = document.getElementById('googleModalBtnContainer');
                if (modalBtn) {
                    google.accounts.id.renderButton(
                        modalBtn,
                        {
                            theme: 'outline',
                            size: 'large',
                            width: 300,
                            text: 'signin_with',
                            shape: 'rectangular',
                            logo_alignment: 'left'
                        }
                    );
                }
            }
        });
    </script>

    <!-- Antigravity Animation Engine -->
    <script src="@Url.Content("~/Scripts/antigravity/antigravity.js")"></script>
    <script src="@Url.Content("~/Scripts/animations-3d.js")"></script>

    @RenderSection("scripts", required: false)
