@using ĐACN.Models
@{
    Layout = null;

    var tk = Session["TaiKhoan"] as TaiKhoan;
    string googleClientId = System.Configuration.ConfigurationManager.AppSettings["Google:ClientId"];
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TapFood</title>
    
    <!-- PWA Setup -->
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#ff5a00">
    <link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/1046/1046784.png">

    <!-- Bootstrap CSS -->
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/animations-3d.css")" rel="stylesheet" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    
    <!-- FontAwesome & SweetAlert2 & AOS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://accounts.google.com/gsi/client" async defer></script>
    
    <style>
        .nav-item.dropdown > a::after {
            content: "▾";
            font-size: 0.8em;
            margin-left: 4px;
            transition: transform 0.3s;
        }

        .nav-item.dropdown > a {
            text-decoration: none;
            border: none;
        }

        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu > .dropdown-menu {
                top: 0;
                left: 100%;
                margin-left: 0.1rem;
                display: none;
            }

        @@media (min-width: 992px) {
            .dropdown-submenu:hover > .dropdown-menu {
                display: block;
            }
        }

        /* Modern UI Additions */
        .text-gradient {
            background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .cart-icon-wrapper {
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .cart-icon-wrapper:hover {
            transform: scale(1.15) rotate(-5deg);
        }
        
        .user-dropdown-toggle:hover img {
            transform: scale(1.1);
            box-shadow: 0 4px 10px rgba(212,175,55,0.3);
        }

        /* Mobile Bottom Navigation */
        .bottom-nav {
            display: none;
            position: fixed;
            bottom: 0;
            width: 100%;
            background: rgba(30, 32, 36, 0.98);
            backdrop-filter: blur(10px);
            box-shadow: 0 -2px 15px rgba(0,0,0,0.2);
            z-index: 1050;
            justify-content: space-around;
            padding: 8px 0;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .bottom-nav-item {
            text-align: center;
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            font-size: 0.75rem;
            flex: 1;
            position: relative;
            transition: color 0.3s;
        }

        .bottom-nav-item i {
            font-size: 1.3rem;
            display: block;
            margin-bottom: 2px;
        }

        .bottom-nav-item.active {
            color: var(--primary-color);
            font-weight: bold;
        }
        
        .bottom-nav-item:hover {
            color: var(--primary-color);
        }

        .premium-dark-footer {
            background: #1e2024; /* Giữ nền tối như ý người dùng */
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            color: #ffffff;
            position: relative;
            z-index: 10;
        }
        .premium-dark-footer h5 {
            color: #ffffff;
        }
        .premium-dark-footer a {
            color: #ffffff !important;
        }
        .premium-dark-footer .text-muted {
            color: rgba(255, 255, 255, 0.9) !important; /* Đổi màu xám thành trắng */
        }
        .premium-dark-footer .social-icon {
            color: #ffffff;
            transition: color 0.3s ease, transform 0.3s ease;
        }
        .premium-dark-footer .social-icon:hover {
            color: var(--primary-color) !important;
            transform: translateY(-3px);
        }
        
        .body-content {
            min-height: calc(100vh - 350px); /* Push footer down */
            position: relative;
        }

        /* Đảm bảo tất cả Modal luôn hiển thị phía trên Modal Backdrop */
        .modal {
            z-index: 1060 !important;
        }
        .modal-backdrop {
            z-index: 1050 !important;
        }

        @@media (max-width: 768px) {
            .bottom-nav {
                display: flex;
            }
            body {
                padding-bottom: 60px; /* Space for bottom nav */
            }
        }
        /* ========================================================
           SweetAlert2 Custom Toast (Vị trí & Màu sắc)
           - Dời xuống dưới thanh navbar để không che các chức năng phía trên
           - Đổi màu nền tối sang trọng để không trùng hòa lẫn với nền trắng
           ======================================================== */
        .swal2-container.swal2-top-end,
        .swal2-container.swal2-top-right {
            top: 85px !important;
            right: 25px !important;
            z-index: 99999 !important;
        }

        .swal2-popup.swal2-toast {
            background: #1e2024 !important;
            color: #ffffff !important;
            border: 1px solid rgba(255, 255, 255, 0.15) !important;
            border-left: 4px solid #10b981 !important;
            border-radius: 12px !important;
            box-shadow: 0 12px 35px rgba(0, 0, 0, 0.35), 0 4px 10px rgba(0, 0, 0, 0.2) !important;
            padding: 12px 18px !important;
        }

        .swal2-popup.swal2-toast .swal2-title {
            color: #ffffff !important;
            font-size: 0.95rem !important;
            font-weight: 600 !important;
            margin: 0 10px !important;
        }

        .swal2-popup.swal2-toast .swal2-html-container {
            color: #d1d5db !important;
            font-size: 0.85rem !important;
        }

        /* Icon Success */
        .swal2-popup.swal2-toast.swal2-icon-success,
        .swal2-popup.swal2-toast .swal2-icon.swal2-success {
            border-color: #10b981 !important;
            color: #10b981 !important;
        }
        .swal2-popup.swal2-toast.swal2-icon-success {
            border-left-color: #10b981 !important;
        }
        .swal2-popup.swal2-toast .swal2-icon.swal2-success .swal2-success-ring {
            border-color: rgba(16, 185, 129, 0.4) !important;
        }
        .swal2-popup.swal2-toast .swal2-icon.swal2-success [class^='swal2-success-line'] {
            background-color: #10b981 !important;
        }

        /* Icon Info */
        .swal2-popup.swal2-toast.swal2-icon-info,
        .swal2-popup.swal2-toast .swal2-icon.swal2-info {
            border-color: #3b82f6 !important;
            color: #3b82f6 !important;
        }
        .swal2-popup.swal2-toast.swal2-icon-info {
            border-left-color: #3b82f6 !important;
        }

        /* Icon Warning */
        .swal2-popup.swal2-toast.swal2-icon-warning,
        .swal2-popup.swal2-toast .swal2-icon.swal2-warning {
            border-color: #f59e0b !important;
            color: #f59e0b !important;
        }
        .swal2-popup.swal2-toast.swal2-icon-warning {
            border-left-color: #f59e0b !important;
        }

        /* Icon Error */
        .swal2-popup.swal2-toast.swal2-icon-error,
        .swal2-popup.swal2-toast .swal2-icon.swal2-error {
            border-color: #ef4444 !important;
            color: #ef4444 !important;
        }
        .swal2-popup.swal2-toast.swal2-icon-error {
            border-left-color: #ef4444 !important;
        }

        /* Timer progress bar */
        .swal2-popup.swal2-toast .swal2-timer-progress-bar {
            background: #10b981 !important;
            height: 3px !important;
        }
    </style>
</head>
