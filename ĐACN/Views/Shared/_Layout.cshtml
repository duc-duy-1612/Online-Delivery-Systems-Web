@using ĐACN.Models
@{
    Layout = null;

    var tk = Session["TaiKhoan"] as TaiKhoan;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - TapFood</title>
    
    <!-- PWA Setup -->
    <link rel="manifest" href="~/manifest.json">
    <meta name="theme-color" content="#ff5a00">
    <link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/1046/1046784.png">

    <!-- Bootstrap CSS -->
    <link href="@Url.Content("~/Content/bootstrap.min.css")" rel="stylesheet" />
    <link href="@Url.Content("~/Content/Site.css")" rel="stylesheet" />

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    
    <!-- FontAwesome & SweetAlert2 & AOS -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    
    <style>
        .nav-item.dropdown > a::after {
            content: "▾";
            font-size: 0.8em;
            margin-left: 4px;
            transition: transform 0.3s;
        }

        .nav-item.dropdown > a {
            text-decoration: none;
            border: none;
        }

        .dropdown-submenu {
            position: relative;
        }

            .dropdown-submenu > .dropdown-menu {
                top: 0;
                left: 100%;
                margin-left: 0.1rem;
                display: none;
            }

        @@media (min-width: 992px) {
            .dropdown-submenu:hover > .dropdown-menu {
                display: block;
            }
        }

        /* Modern UI Additions */
        .glass-nav {
            background: linear-gradient(135deg, #1e2024 0%, #2b2f33 100%) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }
        
        .text-gradient {
            background: linear-gradient(135deg, #ff416c, #ff4b2b);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .navbar-dark .nav-link {
            color: rgba(255, 255, 255, 0.85) !important;
            font-weight: 500;
            position: relative;
            transition: color 0.3s ease;
        }

        .navbar-dark .nav-link:hover {
            color: #ff4b2b !important;
        }

        .navbar-dark .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 50%;
            background-color: #ff4b2b;
            transition: all 0.3s ease;
            transform: translateX(-50%);
        }

        .navbar-dark .nav-link:hover::after {
            width: 80%;
        }

        .cart-icon-wrapper {
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        .cart-icon-wrapper:hover {
            transform: scale(1.15) rotate(-5deg);
        }
        
        .user-dropdown-toggle:hover img {
            transform: scale(1.1);
            box-shadow: 0 4px 10px rgba(255,75,43,0.3);
        }

        /* Mobile Bottom Navigation */
        .bottom-nav {
            display: none;
            position: fixed;
            bottom: 0;
            width: 100%;
            background: rgba(30, 32, 36, 0.98);
            backdrop-filter: blur(10px);
            box-shadow: 0 -2px 15px rgba(0,0,0,0.2);
            z-index: 1050;
            justify-content: space-around;
            padding: 8px 0;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .bottom-nav-item {
            text-align: center;
            color: rgba(255, 255, 255, 0.6);
            text-decoration: none;
            font-size: 0.75rem;
            flex: 1;
            position: relative;
            transition: color 0.3s;
        }

        .bottom-nav-item i {
            font-size: 1.3rem;
            display: block;
            margin-bottom: 2px;
        }

        .bottom-nav-item.active {
            color: #ff4b2b;
            font-weight: bold;
        }
        
        .bottom-nav-item:hover {
            color: #ff4b2b;
        }

        @@media (max-width: 768px) {
            .bottom-nav {
                display: flex;
            }
            body {
                padding-bottom: 60px; /* Space for bottom nav */
            }
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark glass-nav sticky-top shadow-sm py-2">
        <div class="container">
            <a class="navbar-brand fw-bold fs-3 text-gradient" href="@Url.Action("TrangChu", "Home")">
                <img src="~/images/logo.jpg" alt="TapFood" style="height: 30px; margin-right: 8px; border-radius: 4px;" />TapFood
            </a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item"><a class="nav-link" href="@Url.Action("TrangChu", "Home")">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link require-login" href="@Url.Action("DanhMuc", "Home")">Danh mục</a></li>
                    <li class="nav-item"><a class="nav-link require-login" href="@Url.Action("NhaHang", "Home")">Nhà hàng nổi bật</a></li>

                    @if (tk != null)
                    {
                        if (tk.VaiTro == "KhachHang")
                        {
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("DonHangCuaToi", "KhachHang")">Đơn hàng</a></li>
                            <li class="nav-item ms-2">
                                <a class="nav-link position-relative d-flex align-items-center cart-icon-wrapper" href="@Url.Action("XemGioHang", "KhachHang")">
                                    <i class="fa-solid fa-cart-shopping me-1 fs-5"></i> Giỏ hàng
                                    <span id="cartBadge" class="badge bg-danger rounded-pill position-absolute top-0 start-100 translate-middle" style="display: none; font-size: 0.7rem; box-shadow: 0 2px 5px rgba(220,53,69,0.5);">0</span>
                                </a>
                            </li>
                        }

                        if (tk.VaiTro == "Admin")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Quản trị
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="adminDropdown">
                                    <!-- Admin menu -->
                                </ul>
                            </li>
                        }

                        if (tk.VaiTro == "NhaHang")
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle fw-semibold" href="#" id="nhahangDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Quản lý
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="nhahangDropdown">
                                    <li><a class="dropdown-item" href="@Url.Action("DanhSachDonHang", "NhaHang")">Danh sách đơn hàng</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("QuanLySanPham", "NhaHang")">Quản lý sản phẩm</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("ThemSanPham", "NhaHang")">Thêm sản phẩm</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("ThongKe", "NhaHang")">Thống kê</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("ThongTinCuaHang", "NhaHang")">Thông tin cửa hàng</a></li>
                                </ul>
                            </li>
                        }

                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle fw-semibold d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @tk.TenDangNhap
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                @if (tk.VaiTro == "NhaHang")
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("ThongTinCuaHang", "NhaHang")">Hồ sơ Cửa Hàng</a></li>
                                }
                                else if (tk.VaiTro == "KhachHang")
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("HoSo", "KhachHang")">Hồ sơ của tôi</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("DonHangCuaToi", "KhachHang")">Đơn hàng của tôi</a></li>
                                    <li><a class="dropdown-item" href="@Url.Action("CaiDat", "KhachHang")">Cài đặt tài khoản</a></li>
                                }
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")">Đăng xuất</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="btn btn-primary-custom ms-2" href="@Url.Action("Login", "Account")">Đăng nhập</a>
                        </li>
                    }
                    <li class="nav-item d-none align-self-center ms-3" id="installContainer">
                        <button id="btnInstall" class="btn btn-sm btn-danger rounded-pill shadow-sm px-3" style="background: linear-gradient(135deg, #ff416c, #ff4b2b); border: none;">
                            <i class="fa-solid fa-download me-1"></i> Tải App
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <main class="body-content mt-4">
        @RenderBody()
    </main>

    <!-- Modal Đăng nhập Toàn cục -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Đăng nhập</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <form id="loginForm">
                        <div class="mb-3">
                            <label for="username" class="form-label">Tên đăng nhập</label>
                            <input type="text" class="form-control" id="username" name="username" required />
                        </div>
                        <div class="mb-3">
                            <label for="password" class="form-label">Mật khẩu</label>
                            <input type="password" class="form-control" id="password" name="password" required />
                        </div>
                        <div id="loginError" class="text-danger mb-2" style="display:none;"></div>
                        <button type="submit" class="btn btn-primary-custom w-100">Đăng nhập</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
    <footer class="bg-dark text-light pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3"><img src="~/images/logo.jpg" alt="TapFood" style="height: 24px; margin-right: 8px; border-radius: 4px;" />TapFood</h5>
                    <p class="text-muted">Nền tảng đặt đồ ăn trực tuyến hàng đầu, mang đến bữa ăn ngon miệng và nhanh chóng cho bạn mỗi ngày.</p>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3">Về chúng tôi</h5>
                    <ul class="list-unstyled text-muted">
                        <li class="mb-2"><a href="@Url.Action("TrangChu", "Home")" class="text-muted text-decoration-none">Trang chủ</a></li>
                        <li class="mb-2"><a href="@Url.Action("NhaHang", "Home")" class="text-muted text-decoration-none">Nhà hàng</a></li>
                        <li class="mb-2"><a href="#" class="text-muted text-decoration-none">Chính sách bảo mật</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-4">
                    <h5 class="fw-bold mb-3">Liên hệ</h5>
                    <p class="text-muted mb-2"><i class="fa-solid fa-phone me-2"></i> 1900 9999</p>
                    <p class="text-muted mb-2"><i class="fa-solid fa-envelope me-2"></i> support@tapfood.vn</p>
                    <div class="mt-3">
                        <a href="#" class="text-light me-3 fs-5"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="text-light me-3 fs-5"><i class="fa-brands fa-instagram"></i></a>
                    </div>
                </div>
            </div>
            <hr class="border-secondary mt-4 mb-4" />
            <div class="text-center text-muted small">
                &copy; @DateTime.Now.Year - TapFood Delivery. All rights reserved.
            </div>
        </div>
    </footer>

    </footer>

    <!-- Mobile Bottom Navigation (Chỉ hiện trên điện thoại) -->
    <div class="bottom-nav d-md-none">
        <a href="@Url.Action("TrangChu", "Home")" class="bottom-nav-item active">
            <i class="fa-solid fa-house"></i>
            Trang chủ
        </a>
        @if (tk == null || tk.VaiTro == "KhachHang")
        {
            <a href="@Url.Action("XemGioHang", "KhachHang")" class="bottom-nav-item require-login">
                <i class="fa-solid fa-cart-shopping"></i>
                Giỏ hàng
                <span id="mobileCartBadge" class="badge bg-danger rounded-pill position-absolute" style="display: none; top: -5px; right: 25%; font-size: 0.6rem;">0</span>
            </a>
            <a href="@Url.Action("DonHangCuaToi", "KhachHang")" class="bottom-nav-item require-login">
                <i class="fa-solid fa-receipt"></i>
                Đơn hàng
            </a>
            <a href="@Url.Action("HoSo", "KhachHang")" class="bottom-nav-item require-login">
                <i class="fa-solid fa-user"></i>
                Tài khoản
            </a>
        }
        else
        {
            <a href="@Url.Action("DanhSachDonHang", "NhaHang")" class="bottom-nav-item">
                <i class="fa-solid fa-store"></i>
                Quản lý
            </a>
            <a href="@Url.Action("Logout", "Account")" class="bottom-nav-item">
                <i class="fa-solid fa-right-from-bracket"></i>
                Đăng xuất
            </a>
        }
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="@Url.Content("~/Scripts/bootstrap.bundle.min.js")"></script>
    @Scripts.Render("~/bundles/bootstrap")
    
    @if (tk != null && tk.VaiTro == "KhachHang")
    {
        @Html.Partial("~/Views/KhachHang/_DanhGiaShipperModal.cshtml")
        @Html.Partial("~/Views/KhachHang/_DanhGiaNhaHangModal.cshtml")
    }

    <script>
        function updateCartBadge() {
            @if (tk != null && tk.VaiTro == "KhachHang")
            {
                <text>
                $.ajax({
                    url: '@Url.Action("LayThongTinGioHang", "KhachHang")',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            var count = response.soLuong || 0;
                            var badge = $('#cartBadge');
                            var mobileBadge = $('#mobileCartBadge');
                            if (count > 0) {
                                badge.text(count).show();
                                mobileBadge.text(count).show();
                            } else {
                                badge.hide();
                                mobileBadge.hide();
                            }
                        }
                    },
                    error: function() {
                        $('#cartBadge').hide();
                    }
                });
                </text>
            }
        }

        $(document).ready(function () {
            updateCartBadge();
            
            // Xóa tính năng setInterval tự động polling để giảm tải server
            
            @if (tk != null && tk.VaiTro == "KhachHang")
            {
                <text>
                window.kiemTraVaHienThiDonTiepTheo = function() {
                    if (typeof $ === 'undefined' || !$) {
                        setTimeout(window.kiemTraVaHienThiDonTiepTheo, 100);
                        return;
                    }
                    
                    // Nếu đang hiển thị modal đánh giá, tạm dừng vòng lặp này để không bị chèn ép popup
                    if ($('.modal.show').length > 0) {
                        setTimeout(window.kiemTraVaHienThiDonTiepTheo, 15000);
                        return;
                    }
                    
                    var skippedStr = localStorage.getItem('skipped_rating_orders');
                    var skippedOrders = skippedStr ? JSON.parse(skippedStr) : [];
                    
                    $.ajax({
                        url: '/KhachHang/LayDonTiepTheoCanDanhGia',
                        type: 'GET',
                        traditional: true,
                        data: { skippedOrders: skippedOrders },
                        success: function (response) {
                            if (response.success && response.danhGia) {
                                if (typeof window.hienThiModalDanhGia !== 'undefined') {
                                    window.hienThiModalDanhGia(response.danhGia);
                                }
                            }
                            // Kiểm tra lại sau 15 giây
                            setTimeout(window.kiemTraVaHienThiDonTiepTheo, 15000);
                        },
                        error: function () {
                            setTimeout(window.kiemTraVaHienThiDonTiepTheo, 15000);
                        }
                    });
                }

                // Khởi chạy vòng lặp đầu tiên sau 5 giây
                setTimeout(window.kiemTraVaHienThiDonTiepTheo, 5000);
                </text>
            }
            $('.nav-item.dropdown').hover(
                function () {
                    if ($(window).width() > 992) {
                        $(this).addClass('show');
                        $(this).find('> .dropdown-menu').first().addClass('show');
                    }
                },
                function () {
                    if ($(window).width() > 992) {
                        $(this).removeClass('show');
                        $(this).find('> .dropdown-menu').first().removeClass('show');
                    }
                }
            );

            $('.dropdown-submenu').hover(
                function () {
                    if ($(window).width() > 992) {
                        $(this).addClass('show');
                        $(this).find('> .dropdown-menu').first().addClass('show');
                    }
                },
                function () {
                    if ($(window).width() > 992) {
                        $(this).removeClass('show');
                        $(this).find('> .dropdown-menu').first().removeClass('show');
                    }
                }
            );

            $('.nav-item.dropdown > a, .dropdown-submenu > a').click(function (e) {
                if ($(window).width() < 992) {
                    e.preventDefault();
                    $(this).parent().toggleClass('show');
                    $(this).siblings('.dropdown-menu').toggleClass('show');
                }
            });

            // Xử lý chặn link yêu cầu đăng nhập toàn cục
            var tkSession = '@(tk != null ? "true" : "false")';
            var roleGlobal = '@(tk != null ? tk.VaiTro : "")';
            var isUserLoggedInGlobal = (tkSession === 'true');

            // Sử dụng event delegation để bắt tất cả sự kiện click, kể cả phần tử tạo sau
            $(document).on("click", ".require-login", function (e) {
                if (!isUserLoggedInGlobal) {
                    e.preventDefault();
                    var loginModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('loginModal'));
                    loginModal.show();
                } else if (roleGlobal !== 'KhachHang') {
                    e.preventDefault();
                    alert("Vui lòng đăng nhập bằng tài khoản Khách Hàng để thực hiện chức năng đặt món.");
                }
            });

            // Ajax xử lý form login toàn cục
            $("#loginForm").submit(function (e) {
                e.preventDefault();
                const username = $("#username").val();
                const password = $("#password").val();

                $.ajax({
                    url: '@Url.Action("Login", "Account")',
                    type: 'POST',
                    data: { username: username, password: password },
                    success: function (res) {
                        if (res.success) {
                            var modal = bootstrap.Modal.getInstance(document.getElementById('loginModal'));
                            if (modal) modal.hide();
                            location.reload();
                        } else {
                            $("#loginError").text(res.message).show();
                        }
                    },
                    error: function () {
                        $("#loginError").text("Đã xảy ra lỗi khi đăng nhập.").show();
                    }
                });
            });
            
            // Register PWA Service Worker
            if ('serviceWorker' in navigator) {
                navigator.serviceWorker.register('/sw.js')
                .then(() => console.log("Service Worker Registered"));
            }

            // Handle PWA Install Prompt
            let deferredPrompt;
            const installContainer = document.getElementById('installContainer');
            const btnInstall = document.getElementById('btnInstall');

            window.addEventListener('beforeinstallprompt', (e) => {
                e.preventDefault();
                deferredPrompt = e;
                installContainer.classList.remove('d-none');
            });

            if(btnInstall) {
                btnInstall.addEventListener('click', async () => {
                    if (deferredPrompt !== null) {
                        deferredPrompt.prompt();
                        const { outcome } = await deferredPrompt.userChoice;
                        if (outcome === 'accepted') {
                            installContainer.classList.add('d-none');
                        }
                        deferredPrompt = null;
                    }
                });
            }
        });
    </script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/signalr.js/2.4.3/jquery.signalR.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script>
        $(function () {
            var hub = $.connection.deliveryHub;
            
            hub.client.notifyNewOrder = function (message) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'info',
                        title: 'Thông báo đơn hàng',
                        text: message,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 5000,
                        timerProgressBar: true
                    });
                } else {
                    alert(message);
                }
            };

            $.connection.hub.start().done(function () {
                var maKH = '@Session["MaKH"]';
                if (maKH) {
                    hub.server.joinGroup("KhachHang_" + maKH);
                }
            });
        });
    </script>

    @Html.Partial("~/Views/Shared/_ChatWidget.cshtml")
    
    <!-- AOS JS for Scroll Animations -->
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            AOS.init({
                duration: 800,
                easing: 'ease-in-out',
                once: true,
                offset: 50
            });
        });
    </script>
    
    @RenderSection("scripts", required: false)
</body>
</html>