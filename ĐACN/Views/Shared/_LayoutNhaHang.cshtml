@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Quản lý cửa hàng</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link href="~/Content/animations-3d.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
    html { font-size: 13px; }
    body {
        background-color: #f4f6f9;
        font-family: 'Inter', 'Outfit', 'Segoe UI', sans-serif;
    }

    /* ===== SIDEBAR - Premium Dark ===== */
    .sidebar {
        width: 210px; height: 100vh;
        background: linear-gradient(175deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%);
        position: fixed; top: 0; left: 0;
        color: white; display: flex; flex-direction: column;
        justify-content: space-between;
        box-shadow: 4px 0 20px rgba(0,0,0,0.15);
        z-index: 1000; overflow-y: auto;
    }
    .sidebar::-webkit-scrollbar { width: 4px; }
    .sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.15); border-radius: 4px; }

    .sidebar .brand {
        text-align: center; padding: 22px 0;
        font-size: 1.4rem; font-weight: 800;
        background: linear-gradient(135deg, #ff5a2b, #ff9f1c);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        border-bottom: 1px solid rgba(255,255,255,0.06);
        letter-spacing: -0.5px;
    }

    .sidebar-section {
        padding: 14px 0 5px 22px;
        font-size: 0.72rem; text-transform: uppercase;
        color: rgba(255,255,255,0.35); font-weight: 700;
        letter-spacing: 1.2px;
    }

    .sidebar a {
        display: flex; align-items: center;
        padding: 10px 18px; margin: 3px 12px;
        color: rgba(255,255,255,0.6);
        text-decoration: none;
        transition: all 0.25s cubic-bezier(0.25, 0.8, 0.25, 1);
        border-radius: 10px; font-weight: 500;
        font-size: 0.9rem; gap: 10px;
    }
    .sidebar a i { font-size: 1rem; transition: transform 0.25s; }
    .sidebar a:hover {
        background: rgba(255,255,255,0.07);
        color: #fff; transform: translateX(4px);
    }
    .sidebar a.active {
        background: linear-gradient(135deg, rgba(255,90,43,0.9), rgba(255,159,28,0.85));
        color: white;
        box-shadow: 0 4px 14px rgba(255,90,43,0.35);
    }
    .sidebar a.active i { transform: scale(1.1); }

    .sidebar-footer {
        padding: 16px; border-top: 1px solid rgba(255,255,255,0.06);
        display: flex; flex-direction: column; gap: 8px;
    }
    .sidebar-footer a {
        border-radius: 8px; margin: 0;
        color: rgba(255,255,255,0.6);
        justify-content: center;
        padding: 8px 16px;
        font-size: 0.85rem;
    }
    .sidebar-footer a:hover { background: rgba(255,255,255,0.08); color: #fff; transform: none; }
    .sidebar-footer .btn-logout {
        background: rgba(239,68,68,0.12); color: #fc8181;
        border: 1px solid rgba(239,68,68,0.2);
    }
    .sidebar-footer .btn-logout:hover { background: rgba(239,68,68,0.2); color: #fca5a5; }
    .sidebar-footer .text-muted { color: rgba(255,255,255,0.25) !important; font-size: 0.75rem; text-align: center; }

    /* ===== MAIN CONTENT ===== */
    .main-content { margin-left: 210px; padding: 20px 24px; }

    /* ===== TOP NAVBAR ===== */
    .navbar {
        background: rgba(255,255,255,0.92) !important;
        backdrop-filter: blur(12px);
        box-shadow: 0 4px 20px rgba(0,0,0,0.04);
        border-radius: 1rem;
        margin-bottom: 24px !important;
        padding: 14px 20px;
        border: 1px solid rgba(0,0,0,0.05) !important;
    }
    .navbar-brand { font-weight: 700; color: #1a202c !important; }
    .navbar .bi-bell, .navbar .bi-person-circle { color: #718096; font-size: 1.2rem; cursor: pointer; transition: color 0.2s; }
    .navbar .bi-bell:hover, .navbar .bi-person-circle:hover { color: #ff5a2b; }

    /* ===== GLOBAL CARD STYLES ===== */
    .card, .admin-card {
        border: 1px solid rgba(0,0,0,0.06) !important;
        border-radius: 1rem !important;
        box-shadow: 0 4px 16px rgba(0,0,0,0.05) !important;
        background: #fff;
    }

    /* ===== TABLE ===== */
    .table { vertical-align: middle; }
    .table thead th {
        border-bottom: 2px solid #e2e8f0 !important;
        font-weight: 700; text-transform: uppercase;
        font-size: 0.75rem; color: #64748b;
        letter-spacing: 0.06em; background: #f8fafc !important;
        padding: 12px 16px;
    }
    .table tbody tr { transition: background 0.15s; }
    .table tbody tr:hover { background: #fffaf8 !important; transform: none !important; box-shadow: none !important; }
    .table td { border-color: #f0f2f5 !important; padding: 12px 16px; }

    /* ===== BUTTONS ===== */
    .btn-action {
        border-radius: 0.6rem; padding: 6px 14px;
        font-weight: 600; transition: all 0.2s; font-size: 0.85rem;
    }
    .btn-action:hover { transform: translateY(-1px); }
    .btn-dark.btn-modern, .btn-modern {
        background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important;
        border: none !important; color: #fff !important;
        border-radius: 0.75rem; font-weight: 700;
        padding: 8px 18px;
        box-shadow: 0 4px 12px rgba(255,90,43,0.25);
        transition: all 0.2s;
    }
    .btn-dark.btn-modern:hover, .btn-modern:hover {
        transform: translateY(-1px); box-shadow: 0 8px 20px rgba(255,90,43,0.35) !important;
    }
    .btn-outline-dark {
        border-color: #e2e8f0 !important; color: #4a5568 !important;
        border-radius: 0.75rem; font-weight: 600;
    }
    .btn-outline-dark:hover { background: #f7fafc !important; border-color: #cbd5e0 !important; }

    /* ===== FORM CONTROLS ===== */
    .form-control.bg-light, .form-select.bg-light, .form-control, .form-select {
        border-radius: 0.75rem !important;
        border: 1.5px solid #e2e8f0 !important;
        background: #f7fafc !important;
        color: #2d3748 !important;
        transition: all 0.2s;
    }
    .form-control:focus, .form-select:focus {
        background: #fff !important; border-color: #ff5a2b !important;
        box-shadow: 0 0 0 3px rgba(255,90,43,0.12) !important;
    }

    /* ===== BADGES ===== */
    .badge.bg-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; color: #fff !important; }
    .badge.bg-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; }
    .badge.bg-warning { background: linear-gradient(135deg, #f59e0b, #d97706) !important; color: #fff !important; }
    .badge.bg-info    { background: linear-gradient(135deg, #3b82f6, #2563eb) !important; color: #fff !important; }

    /* ===== PAGE TITLES ===== */
    h2.fw-bold, h3.fw-bold { color: #1a202c !important; }
    .text-muted { color: #718096 !important; }
</style>
</head>

<body>
    <div class="sidebar">
        <div>
            <div class="brand">Cửa hàng</div>

            <div class="sidebar-section">Cửa hàng</div>
            <a href="@Url.Action("ThongKe","NhaHang")" class="@(ViewBag.Active=="ThongKe"?"active":"")">
                <i class="bi bi-bar-chart"></i> Thống kê
            </a>
            <a href="@Url.Action("ThongTinCuaHang","NhaHang")" class="@(ViewBag.Active=="ThongTin"?"active":"")">
                <i class="bi bi-shop"></i> Thông tin cửa hàng
            </a>

            <div class="sidebar-section">Sản phẩm</div>
            <a href="@Url.Action("QuanLySanPham","NhaHang")" class="@(ViewBag.Active=="SanPham"?"active":"")">
                <i class="bi bi-box-seam"></i> Danh sách sản phẩm
            </a>
            <a href="@Url.Action("ThemSanPham","NhaHang")" class="@(ViewBag.Active=="ThemSP"?"active":"")">
                <i class="bi bi-plus-circle"></i> Thêm sản phẩm
            </a>
            <a href="@Url.Action("DanhMuc","NhaHang")" class="@(ViewBag.Active=="DanhMuc"?"active":"")">
                <i class="bi bi-tags"></i> Danh mục
            </a>

            <div class="sidebar-section">Bán hàng</div>
            <a href="@Url.Action("DanhSachDonHang","NhaHang")" class="@(ViewBag.Active=="DonHang"?"active":"")">
                <i class="bi bi-receipt"></i> Danh sách đơn hàng
            </a>

            <div class="sidebar-section">Phản hồi</div>
            <a href="@Url.Action("PhanHoi","NhaHang")" class="@(ViewBag.Active=="PhanHoi"?"active":"")">
                <i class="bi bi-chat-left-dots"></i> Phản hồi
            </a>
        </div>

        <div class="sidebar-footer">
            <a href="@Url.Action("TrangChu", "Home")" class="text-decoration-none mb-1">
                <i class="bi bi-house" style="margin-right: 8px;"></i> Về trang chủ
            </a>
            <a href="@Url.Action("Logout","Account")" class="text-decoration-none btn-logout">
                <i class="bi bi-box-arrow-right" style="margin-right: 8px;"></i> Đăng xuất
            </a>
            <div class="mt-3 text-muted">© 2025 FoodDelivery</div>
        </div>
    </div>

    <div class="main-content">
        <nav class="navbar navbar-light mb-4">
            <div class="container-fluid">
                <span class="navbar-brand mb-0 h5">@ViewBag.Title</span>
                <div class="d-flex align-items-center">
                    <i class="bi bi-bell me-3 fs-5"></i>
                    <i class="bi bi-person-circle fs-4"></i>
                </div>
            </div>
        </nav>

        @RenderBody()
    </div>
    @Html.Partial("~/Views/Shared/_ChatWidget.cshtml")
    
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/signalr.js/2.4.3/jquery.signalR.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script>
        $(function () {
            var hub = $.connection.deliveryHub;
            
            hub.client.notifyNewOrder = function (message) {
                Swal.fire({
                    icon: 'info',
                    title: 'Thông báo',
                    text: message,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true
                });
            };

            $.connection.hub.start().done(function () {
                var maNH = '@Session["MaNH"]';
                if (maNH) {
                    hub.server.joinGroup("NhaHang_" + maNH);
                }
            });
        });
    </script>
    
    <script src="~/Scripts/animations-3d.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

