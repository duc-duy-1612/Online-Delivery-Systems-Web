@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - Quản lý cửa hàng</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        html {
            font-size: 13px; /* Scales down all Bootstrap rem units to ~81% */
        }
        body {
            background-color: #f4f6f9;
            font-family: 'Outfit', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Sidebar */
        .sidebar {
            width: 210px;
            height: 100vh;
            background-color: #121418;
            position: fixed;
            top: 0;
            left: 0;
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: 4px 0 15px rgba(0,0,0,0.05);
            z-index: 1000;
            overflow-y: auto;
        }
        
        /* Tùy chỉnh thanh cuộn cho sidebar */
        .sidebar::-webkit-scrollbar {
            width: 6px;
        }
        .sidebar::-webkit-scrollbar-thumb {
            background-color: rgba(255, 255, 255, 0.2);
            border-radius: 10px;
        }

        .sidebar .brand {
            text-align: center;
            padding: 25px 0;
            font-size: 1.5rem;
            font-weight: 800;
            background: linear-gradient(135deg, #f2994a, #f2c94c);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .sidebar-section {
            padding: 15px 0 5px 25px;
            font-size: 0.85rem;
            text-transform: uppercase;
            color: #6c757d;
            font-weight: 600;
            letter-spacing: 1px;
        }

        .sidebar a {
            display: block;
            padding: 12px 20px;
            margin: 4px 15px;
            color: #a0a5ba;
            text-decoration: none;
            transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
            border-radius: 12px;
            font-weight: 500;
        }

        .sidebar a i {
            margin-right: 12px;
            font-size: 1.1rem;
            transition: transform 0.3s;
        }

        .sidebar a:hover {
            background-color: rgba(255,255,255,0.05);
            color: #fff;
            transform: translateX(5px);
        }

        .sidebar a.active {
            background: linear-gradient(135deg, #f2994a, #f2c94c);
            color: white;
            box-shadow: 0 4px 15px rgba(242, 153, 74, 0.4);
        }
        
        .sidebar a.active i {
            transform: scale(1.1);
        }

        .sidebar-footer {
            text-align: center;
            padding: 20px;
            font-size: 0.9rem;
            color: #888;
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }
        
        .sidebar-footer a {
            color: #f2994a;
            background: rgba(242, 153, 74, 0.1);
            border-radius: 50px;
            margin: 0;
            justify-content: center;
            display: flex;
            align-items: center;
        }
        
        .sidebar-footer a:hover {
            background: rgba(242, 153, 74, 0.2);
            color: #f2c94c;
            transform: translateY(-2px);
            box-shadow: 0 4px 10px rgba(242, 153, 74, 0.2);
        }

        /* Main content */
        .main-content {
            margin-left: 210px;
            padding: 24px;
        }

        .navbar {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            box-shadow: 0 4px 20px rgba(0,0,0,0.03);
            border-radius: 16px;
            margin-bottom: 30px !important;
            padding: 15px 25px;
        }
        
        .navbar-brand {
            font-weight: 700;
            color: #2c3e50;
        }
        
        /* Premium Table Styles for all inner views */
        .card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }
        .table {
            vertical-align: middle;
        }
        .table thead th {
            border-bottom: none;
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            color: #6c757d;
            background: #f8f9fa;
        }
        .table tbody tr {
            transition: all 0.3s;
        }
        .table tbody tr:hover {
            background-color: #f8f9fa;
            transform: scale(1.01);
            box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        }
        
        .btn-action {
            border-radius: 50px;
            padding: 6px 15px;
            font-weight: 500;
            transition: all 0.3s;
        }
        .btn-action:hover {
            transform: translateY(-2px);
        }
    </style>
</head>

<body>
    <div class="sidebar">
        <div>
            <div class="brand">Cửa hàng</div>

            <div class="sidebar-section">Cửa hàng</div>
            <a href="@Url.Action("ThongKe","NhaHang")" class="@(ViewBag.Active=="ThongKe"?"active":"")">
                <i class="bi bi-bar-chart"></i> Thống kê
            </a>
            <a href="@Url.Action("ThongTinCuaHang","NhaHang")" class="@(ViewBag.Active=="ThongTin"?"active":"")">
                <i class="bi bi-shop"></i> Thông tin cửa hàng
            </a>

            <div class="sidebar-section">Sản phẩm</div>
            <a href="@Url.Action("QuanLySanPham","NhaHang")" class="@(ViewBag.Active=="SanPham"?"active":"")">
                <i class="bi bi-box-seam"></i> Danh sách sản phẩm
            </a>
            <a href="@Url.Action("ThemSanPham","NhaHang")" class="@(ViewBag.Active=="ThemSP"?"active":"")">
                <i class="bi bi-plus-circle"></i> Thêm sản phẩm
            </a>
            <a href="@Url.Action("DanhMuc","NhaHang")" class="@(ViewBag.Active=="DanhMuc"?"active":"")">
                <i class="bi bi-tags"></i> Danh mục
            </a>

            <div class="sidebar-section">Bán hàng</div>
            <a href="@Url.Action("DanhSachDonHang","NhaHang")" class="@(ViewBag.Active=="DonHang"?"active":"")">
                <i class="bi bi-receipt"></i> Danh sách đơn hàng
            </a>

            <div class="sidebar-section">Phản hồi</div>
            <a href="@Url.Action("PhanHoi","NhaHang")" class="@(ViewBag.Active=="PhanHoi"?"active":"")">
                <i class="bi bi-chat-left-dots"></i> Phản hồi
            </a>
        </div>

        <div class="sidebar-footer">
            <a href="@Url.Action("TrangChu", "Home")" class="text-decoration-none mb-2" style="background: rgba(255, 255, 255, 0.1); color: #e5e7eb;">
                <i class="bi bi-house" style="margin-right: 8px;"></i> Về trang chủ
            </a>
            <a href="@Url.Action("Logout","Account")" class="text-danger text-decoration-none">
                <i class="bi bi-box-arrow-right" style="margin-right: 8px;"></i> Đăng xuất
            </a>
            <div class="mt-3 text-muted">© 2025 FoodDelivery</div>
        </div>
    </div>

    <div class="main-content">
        <nav class="navbar navbar-light mb-4">
            <div class="container-fluid">
                <span class="navbar-brand mb-0 h5">@ViewBag.Title</span>
                <div class="d-flex align-items-center">
                    <i class="bi bi-bell me-3 fs-5"></i>
                    <i class="bi bi-person-circle fs-4"></i>
                </div>
            </div>
        </nav>

        @RenderBody()
    </div>
    @Html.Partial("~/Views/Shared/_ChatWidget.cshtml")
    
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/signalr.js/2.4.3/jquery.signalR.min.js"></script>
    <script src="~/signalr/hubs"></script>
    <script>
        $(function () {
            var hub = $.connection.deliveryHub;
            
            hub.client.notifyNewOrder = function (message) {
                Swal.fire({
                    icon: 'info',
                    title: 'Thông báo',
                    text: message,
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 5000,
                    timerProgressBar: true
                });
            };

            $.connection.hub.start().done(function () {
                var maNH = '@Session["MaNH"]';
                if (maNH) {
                    hub.server.joinGroup("NhaHang_" + maNH);
                }
            });
        });
    </script>
    
    @RenderSection("Scripts", required: false)
</body>
</html>
