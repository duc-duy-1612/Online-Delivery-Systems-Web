@* /Views/Shared/_LayoutAdmin.cshtml *@
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Admin Dashboard</title>
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Site.css" rel="stylesheet" />
    <link href="~/Content/animations-3d.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
    :root {
        --admin-sidebar-bg: #0f172a;
        --admin-accent: #ff5a2b;
        --admin-accent2: #ff9f1c;
        --admin-bg: #f4f6f9;
    }
    html { font-size: 13px; }
    body { font-family: 'Inter', sans-serif; background: var(--admin-bg); margin: 0; padding: 0; overflow-x: hidden; }

    /* ===== ADMIN SIDEBAR ===== */
    .admin-sidebar {
        width: 210px; min-height: 100vh;
        background: linear-gradient(175deg, #0f172a 0%, #1e293b 100%);
        color: #94a3b8; position: fixed; top: 0; left: 0;
        z-index: 1000; overflow-y: auto;
        box-shadow: 4px 0 20px rgba(0,0,0,0.2);
        display: flex; flex-direction: column;
    }
    .admin-sidebar::-webkit-scrollbar { width: 4px; }
    .admin-sidebar::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border-radius: 4px; }

    /* Brand */
    .admin-brand {
        padding: 22px 20px;
        font-size: 1.1rem; font-weight: 800;
        color: #fff;
        border-bottom: 1px solid rgba(255,255,255,0.07);
        display: flex; align-items: center; gap: 8px;
        letter-spacing: -0.3px;
    }
    .admin-brand span {
        background: linear-gradient(135deg, #ff5a2b, #ff9f1c);
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }

    /* Menu */
    .admin-menu { list-style: none; padding: 12px 0; margin: 0; flex: 1; }
    .admin-menu-title {
        padding: 12px 20px 4px;
        font-size: 0.68rem; text-transform: uppercase;
        letter-spacing: 1.5px; color: rgba(255,255,255,0.3);
        font-weight: 700; margin-top: 8px;
    }
    .admin-menu-item { padding: 2px 12px; }
    .admin-menu-link {
        display: flex; align-items: center; gap: 10px;
        padding: 9px 16px;
        color: rgba(255,255,255,0.55);
        text-decoration: none;
        border-radius: 10px;
        font-size: 0.88rem; font-weight: 500;
        transition: all 0.22s ease;
    }
    .admin-menu-link:hover { background: rgba(255,255,255,0.07); color: #fff; transform: translateX(3px); }
    .admin-menu-link.active {
        background: linear-gradient(135deg, rgba(255,90,43,0.85), rgba(255,159,28,0.8));
        color: #fff; font-weight: 700;
        box-shadow: 0 4px 14px rgba(255,90,43,0.3);
    }

    /* Sidebar bottom */
    .admin-sidebar-footer {
        padding: 14px; border-top: 1px solid rgba(255,255,255,0.06);
        display: flex; flex-direction: column; gap: 6px;
    }
    .admin-sidebar-footer a {
        display: flex; align-items: center; gap: 8px;
        padding: 8px 14px; border-radius: 8px;
        text-decoration: none; font-size: 0.85rem; font-weight: 500;
        color: rgba(255,255,255,0.5); transition: all 0.2s;
    }
    .admin-sidebar-footer a:hover { background: rgba(255,255,255,0.07); color: #fff; }
    .logout-link { color: #f87171 !important; }
    .logout-link:hover { background: rgba(239,68,68,0.12) !important; color: #fca5a5 !important; }

    /* ===== MAIN CONTENT ===== */
    .admin-main { margin-left: 210px; min-height: 100vh; display: flex; flex-direction: column; }

    /* ===== HEADER ===== */
    .admin-header {
        background: rgba(255,255,255,0.95);
        backdrop-filter: blur(10px);
        padding: 12px 28px;
        display: flex; justify-content: flex-end; align-items: center;
        border-bottom: 1px solid rgba(0,0,0,0.06);
        position: sticky; top: 0; z-index: 999;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    }

    /* ===== CONTENT ===== */
    .admin-content { padding: 24px; flex-grow: 1; }

    /* ===== ADMIN CARDS ===== */
    .admin-card {
        background: #fff;
        border-radius: 1rem; border: 1px solid rgba(0,0,0,0.06);
        box-shadow: 0 4px 16px rgba(0,0,0,0.05);
        padding: 20px; margin-bottom: 20px;
        transition: box-shadow 0.25s ease;
    }
    .admin-card:hover { box-shadow: 0 8px 28px rgba(0,0,0,0.08); }

    /* ===== BUTTONS ===== */
    .btn-modern {
        border-radius: 0.75rem !important;
        padding: 8px 18px; font-weight: 700;
        transition: all 0.2s ease;
        font-size: 0.88rem;
    }
    .btn-dark.btn-modern {
        background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important;
        border: none !important; color: #fff !important;
        box-shadow: 0 4px 12px rgba(255,90,43,0.25);
    }
    .btn-dark.btn-modern:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(255,90,43,0.35) !important; }
    .btn-outline-dark {
        border-color: #e2e8f0 !important; color: #4a5568 !important;
        border-radius: 0.75rem !important; font-weight: 600;
    }
    .btn-outline-dark:hover { background: #f7fafc !important; }
    .btn-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }

    /* ===== FORM CONTROLS ===== */
    .form-control, .form-select {
        border-radius: 0.75rem !important; border: 1.5px solid #e2e8f0 !important;
        background: #f7fafc !important; color: #2d3748 !important; transition: all 0.2s;
    }
    .form-control.bg-light { background: #f7fafc !important; border: 1.5px solid #e2e8f0 !important; }
    .form-control:focus, .form-select:focus { background: #fff !important; border-color: #ff5a2b !important; box-shadow: 0 0 0 3px rgba(255,90,43,0.12) !important; }

    /* ===== TABLE ===== */
    .table { vertical-align: middle; }
    .table thead th { background: #f8fafc !important; color: #64748b; font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 2px solid #e2e8f0 !important; padding: 12px 16px; }
    .table tbody tr { transition: background 0.15s; }
    .table tbody tr:hover { background: #fffaf8 !important; }
    .table td { border-color: #f0f2f5 !important; padding: 12px 16px; }

    /* ===== BADGES ===== */
    .badge.bg-success  { background: linear-gradient(135deg, #22c55e, #16a34a) !important; color: #fff !important; }
    .badge.bg-danger   { background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; }
    .badge.bg-warning  { background: linear-gradient(135deg, #f59e0b, #d97706) !important; color: #fff !important; }
    .badge.bg-info     { background: linear-gradient(135deg, #3b82f6, #2563eb) !important; color: #fff !important; }
    .badge.bg-secondary{ background: #94a3b8 !important; color: #fff !important; }

    /* ===== PAGE TITLES ===== */
    h2.fw-bold { color: #1a202c !important; }
    .text-muted { color: #718096 !important; }

    /* Alert ===== */
    .alert { border-radius: 0.85rem !important; }
    .alert-success { background: #d1fae5 !important; color: #065f46 !important; border: 1px solid #a7f3d0 !important; }
    .alert-danger  { background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fecaca !important; }
    .alert-info    { background: #dbeafe !important; color: #1e40af !important; border: 1px solid #93c5fd !important; }
</style>
</head>
<body>
    <div class="admin-sidebar">
        <div class="admin-brand">
            <img src="~/images/logo.png" alt="TapFood Logo" style="height: 30px; margin-right: 8px; border-radius: 4px;" /><span>TapFood</span> Admin
        </div>
        <ul class="admin-menu">
            <li class="admin-menu-item">
                <a href="@Url.Action("ThongKe", "Admin")" class="admin-menu-link @(ViewBag.Title == "Thống kê" ? "active" : "")">
                    Tổng quan (Dashboard)
                </a>
            </li>

            <li class="admin-menu-title">Quản lý duyệt</li>
            <li class="admin-menu-item">
                <a href="@Url.Action("CapPhepCuaHang", "Admin")" class="admin-menu-link @(ViewBag.Title == "Cấp phép cửa hàng" ? "active" : "")">
                    Duyệt nhà hàng
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="@Url.Action("CapPhepShipper", "Admin")" class="admin-menu-link @(ViewBag.Title == "Cấp phép Shipper" ? "active" : "")">
                    Duyệt Shipper
                </a>
            </li>

            <li class="admin-menu-title">Dữ liệu</li>
            <li class="admin-menu-item">
                <a href="@Url.Action("QuanLyVoucher", "Admin")" class="admin-menu-link @(ViewBag.Title == "Quản lý Voucher" ? "active" : "")">
                    Mã Giảm Giá (Vouchers)
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="@Url.Action("DanhSachCuaHang", "Admin")" class="admin-menu-link @(ViewBag.Title == "Danh sách cửa hàng" ? "active" : "")">
                    Nhà hàng
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="@Url.Action("DanhSachShipper", "Admin")" class="admin-menu-link @(ViewBag.Title == "Danh sách Shipper" ? "active" : "")">
                    Shipper
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="@Url.Action("DanhSachNguoiDung", "Admin")" class="admin-menu-link @(ViewBag.Title == "Danh sách người dùng" ? "active" : "")">
                    Khách hàng
                </a>
            </li>

            <li class="admin-menu-title" style="margin-top: 40px;">Cá nhân</li>
            <li class="admin-menu-item">
                <a href="@Url.Action("TrangChu", "Home")" class="admin-menu-link">
                    <i class="bi bi-house" style="margin-right: 8px;"></i> Về trang chủ
                </a>
            </li>
            <li class="admin-menu-item">
                <a href="@Url.Action("DangXuat", "Account")" class="admin-menu-link logout-link">
                    <i class="bi bi-box-arrow-right" style="margin-right: 8px;"></i> Đăng xuất
                </a>
            </li>
        </ul>
    </div>

    <div class="admin-main">
        <header class="admin-header">
            <div class="d-flex align-items-center">
                <div class="text-end me-3">
                    <div class="fw-bold" style="font-size: 0.9rem; color: #111827;">Quản trị viên</div>
                    <div class="text-muted" style="font-size: 0.75rem;">Administrator</div>
                </div>
                <div class="rounded-circle bg-dark d-flex justify-content-center align-items-center text-white fw-bold" style="width: 40px; height: 40px;">
                    A
                </div>
            </div>
        </header>

        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/animations-3d.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
