@using ĐACN.Models
@{
    Layout = null;

    // Kiểm tra session user
    var tk = Session["TaiKhoan"] as TaiKhoan;
}

@model IEnumerable<LoaiMonAnViewModel>

@if (Model == null || !Model.Any())
{
    <p class="text-center text-muted mt-3">Chưa có danh mục nào để hiển thị.</p>
}
else
{
    <style>
        .category-scroll {
            display: flex;
            overflow-x: auto;
            gap: 20px;
            padding-bottom: 20px;
            scrollbar-width: none; /* Firefox */
            -ms-overflow-style: none;  /* IE and Edge */
        }
        .category-scroll::-webkit-scrollbar {
            display: none; /* Chrome */
        }

        .category-card {
            border-radius: 20px;
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.5);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            cursor: pointer;
            text-decoration: none;
            color: inherit;
            min-width: 140px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px 10px;
            position: relative;
            overflow: hidden;
        }
        
        .category-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 50%;
            height: 100%;
            background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
            transform: skewX(-25deg);
            transition: 0.5s;
        }

        .category-card:hover::before {
            left: 125%;
        }

        .category-card:hover {
            transform: translateY(-8px);
            background: #fff;
            box-shadow: 0 15px 35px rgba(255,75,43,0.15);
            border-color: rgba(255,75,43,0.3);
            color: #ff4b2b;
        }

        .category-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 50%;
            display: block;
            margin: 0 auto;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        @@media (max-width: 768px) {
            .category-img {
                width: 90px;
                height: 90px;
            }
        }
    </style>

    <div class="category-scroll">
        @{ int delay = 0; }
        @foreach (var dm in Model)
        {
            <a href="@Url.Action("MonAnTheoLoai", "KhachHang", new { maLoai = dm.MaLoai })"
               class="category-link require-login"
               data-id="@dm.MaLoai"
               style="text-decoration:none;"
               data-aos="fade-right" data-aos-delay="@delay">
                <div class="category-card text-center">
                    <img src="@(string.IsNullOrEmpty(dm.HinhAnh) ? Url.Content("~/images/danhmuc/com.png") : Url.Content("~/images/danhmuc/" + dm.HinhAnh))" alt="@dm.TenLoai" class="category-img mb-3" onerror="this.onerror=null; this.src='@Url.Content("~/images/danhmuc/com.png")'" />
                    <h6 class="mt-2 fw-bold mb-0">@dm.TenLoai</h6>
                </div>
            </a>
            delay += 100;
        }
    </div>




}