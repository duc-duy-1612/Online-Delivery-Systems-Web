@model IEnumerable<ĐACN.Shipper>

@{
    ViewBag.Title = "Danh sách người giao hàng";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<style>
    .admin-card { border: 1px solid rgba(0,0,0,0.06); border-radius: 1rem; box-shadow: 0 4px 16px rgba(0,0,0,0.05); background: #fff; padding: 20px; margin-bottom: 20px; }
    h2.fw-bold { color: #1a202c !important; }
    .text-muted { color: #718096 !important; }
    .btn-dark.btn-modern { background: linear-gradient(135deg, #ff5a2b, #ff9f1c) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; color: #fff !important; box-shadow: 0 4px 12px rgba(255,90,43,0.25); }
    .btn-dark.btn-modern:hover { transform: translateY(-1px); box-shadow: 0 8px 20px rgba(255,90,43,0.35) !important; }
    .btn-outline-dark { border-color: #e2e8f0 !important; color: #4a5568 !important; border-radius: 0.75rem !important; font-weight: 600; }
    .btn-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; border: none !important; border-radius: 0.75rem !important; font-weight: 700 !important; }
    .btn-warning { border-radius: 0.75rem !important; font-weight: 700 !important; }
    .form-control, .form-select { border-radius: 0.75rem !important; border: 1.5px solid #e2e8f0 !important; background: #f7fafc !important; color: #2d3748 !important; transition: all 0.2s; }
    .form-control.bg-light { background: #f7fafc !important; border: 1.5px solid #e2e8f0 !important; }
    .form-control:focus, .form-select:focus { background: #fff !important; border-color: #ff5a2b !important; box-shadow: 0 0 0 3px rgba(255,90,43,0.12) !important; }
    .table thead th { background: #f8fafc !important; color: #64748b !important; font-weight: 700 !important; font-size: 0.75rem !important; text-transform: uppercase !important; letter-spacing: 0.06em !important; border-bottom: 2px solid #e2e8f0 !important; }
    .table tbody tr:hover { background: #fffaf8 !important; }
    .table td { border-color: #f0f2f5 !important; vertical-align: middle; }
    .badge { border-radius: 8px !important; font-weight: 700; padding: 4px 10px; }
    .badge.bg-success { background: linear-gradient(135deg, #22c55e, #16a34a) !important; color: #fff !important; }
    .badge.bg-danger  { background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; }
    .badge.bg-warning { background: linear-gradient(135deg, #f59e0b, #d97706) !important; color: #fff !important; }
    .badge.bg-info    { background: linear-gradient(135deg, #3b82f6, #2563eb) !important; color: #fff !important; }
    .badge.bg-secondary { background: #94a3b8 !important; color: #fff !important; }
    .alert { border-radius: 0.85rem !important; }
    .alert-success { background: #d1fae5 !important; color: #065f46 !important; border: 1px solid #a7f3d0 !important; }
    .alert-danger  { background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fecaca !important; }
    .alert-info    { background: #dbeafe !important; color: #1e40af !important; border: 1px solid #93c5fd !important; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1" style="color: #111827;">Danh sách Shipper</h2>
        <p class="text-muted mb-0">Quản lý và tra cứu thông tin đối tác giao hàng trên hệ thống.</p>
    </div>
    <a href="@Url.Action("ThemShipper", "Admin")" class="btn btn-dark btn-modern">
        Thêm Shipper mới
    </a>
</div>

<div class="admin-card border-0 mb-4 p-3">
    <form method="get" class="row g-3 align-items-center">
        <div class="col-md-9">
            <input type="text" name="keyword" value="@ViewBag.Keyword" placeholder="Nhập tên, số điện thoại hoặc biển số xe..." class="form-control bg-light border-0 shadow-none" style="padding: 10px 16px; border-radius: 8px;" />
        </div>
        <div class="col-md-3">
            <button class="btn btn-outline-dark btn-modern w-100" style="padding: 10px 16px;">Tìm kiếm</button>
        </div>
    </form>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success border-0 shadow-sm mb-4" style="border-radius: 8px; background-color: #d1fae5; color: #065f46;">
        @TempData["Message"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-4" style="border-radius: 8px; background-color: #fee2e2; color: #991b1b;">
        @TempData["Error"]
    </div>
}

<div class="admin-card border-0 p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead style="background-color: #f9fafb;">
                <tr>
                    <th class="text-muted fw-bold border-bottom-0 py-3 ps-4" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">STT</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Shipper</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Liên hệ & Phương tiện</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Tài khoản</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3 text-center" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Trạng thái</th>
                    <th class="text-muted fw-bold border-bottom-0 py-3 pe-4 text-end" style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int stt = 1;
                    var danhSach = Model?.OrderByDescending(s => s.MaShipper).ToList() ?? new List<ĐACN.Shipper>();
                }

                @if (danhSach.Any())
                {
                    foreach (var shipper in danhSach)
                    {
                        <tr class="border-bottom" style="transition: all 0.2s ease;">
                            <td class="py-3 ps-4 text-muted">@stt</td>
                            <td class="py-3">
                                <div class="fw-bold" style="color: #111827;">@shipper.TenShipper</div>
                            </td>
                            <td class="py-3">
                                <div class="text-dark fw-medium">@shipper.SDT</div>
                                <div class="text-muted small">BSX: @shipper.BienSoXe</div>
                            </td>
                            <td class="py-3">
                                <div class="text-dark">@(shipper.TaiKhoan?.TenDangNhap ?? "Chưa có")</div>
                            </td>
                            <td class="py-3 text-center">
                                @if (shipper.TaiKhoan != null)
                                {
                                    if (shipper.TaiKhoan.TrangThai == true)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success fw-normal px-3 py-2" style="border-radius: 50px;">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger fw-normal px-3 py-2" style="border-radius: 50px;">Bị khóa</span>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary fw-normal px-3 py-2" style="border-radius: 50px;">Chưa có tài khoản</span>
                                }
                            </td>
                            <td class="py-3 pe-4 text-end">
                                <a href="@Url.Action("ChiTietShipper", "Admin", new { id = shipper.MaShipper })" class="btn btn-sm btn-light fw-medium px-3" style="border-radius: 6px;">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                        stt++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-muted text-center py-5">Không tìm thấy thông tin phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
